---
import BaseLayout from '../../layouts/BaseLayout.astro';

const nav = [
  { id: 'visi-misi', label: 'Visi & Misi' },
  { id: 'sambutan', label: 'Sambutan' },
  { id: 'struktur', label: 'Struktur Organisasi' },
  { id: 'akreditasi', label: 'Akreditasi' },
];

const visi =
  'Menjadi program studi sistem informasi yang unggul, berdaya saing global, dan berintegritas tinggi dalam rekayasa sistem enterprise, kecerdasan buatan, dan sains data untuk kemaslahatan masyarakat pada tahun 2035.';

const misi = [
  'Menyelenggarakan pendidikan yang menghasilkan SDM berintegritas, kompeten, dan menguasai AI serta data science.',
  'Mendorong penelitian dan pengabdian kepada masyarakat di bidang artificial intelligence, sistem informasi dan inovasi digital yang berdampak pada peningkatan kualitas teknologi dan layanan masyarakat.',
  'Mengembangkan ekosistem kolaboratif antara lembaga pendidikan, dunia usaha-dunia industri, UMKM, komunitas kreatif, serta pemerintah untuk meningkatkan kesempatan kerja dan pemberdayaan masyarakat.',
];

const struktur = [
  { role: 'Sekretaris Program Studi', name: 'Eka Prasetyaningrum, S.Kom., M.M.' },
  { role: 'Kepala Laboratorium & MBKM', name: 'Dody Erlangga, S.Kom.' },
  { role: 'Gugus Kendali Mutu', name: 'Nurahman, S.Kom., M.M., M.Kom.' },
  { role: 'Koordinator Kemahasiswaan & Alumni', name: 'Abdul Aziz, S.Pd., M.Pd.' },
];
---

<BaseLayout
  title="Profil Program Studi"
  description="Visi, misi, sambutan pimpinan, struktur organisasi, dan status akreditasi Program Studi S1 Sistem Informasi, Fakultas Ilmu Komputer, Universitas Darwan Ali."
  lang="id"
>
  <header class="bg-navy-900 text-white border-b border-navy-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-12 sm:pt-20 sm:pb-16">
      <p class="font-code text-xs uppercase tracking-[0.2em] text-gold-500 mb-5">Profil Institusi</p>
      <h1 class="font-editorial text-4xl sm:text-5xl lg:text-6xl font-semibold leading-[1.1] max-w-3xl">
        Program Studi S1 Sistem Informasi
      </h1>
      <p class="mt-6 max-w-2xl text-base sm:text-lg text-slate-300 leading-relaxed">
        Fakultas Ilmu Komputer, Universitas Darwan Ali, Sampit. Halaman ini memuat arah, pimpinan, susunan pengelola, dan status mutu program studi.
      </p>
    </div>
  </header>

  <nav aria-label="Navigasi halaman profil" class="sticky top-20 z-40 bg-canvas-light/95 backdrop-blur border-b border-slate-200">
    <ul class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex gap-x-8 overflow-x-auto">
      {nav.map((item, i) => (
        <li class="shrink-0">
          <a
            href={`#${item.id}`}
            class="inline-flex items-center gap-2 min-h-[48px] text-sm font-semibold text-navy-900 border-b-2 border-transparent hover:border-gold-600 focus-visible:border-gold-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-600 focus-visible:ring-offset-2 transition-colors"
          >
            <span class="font-code text-xs text-gold-700">0{i + 1}</span>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    {/* 01 Visi & Misi */}
    <section id="visi-misi" aria-labelledby="visi-misi-h" class="scroll-mt-40 py-16 sm:py-24 border-b border-slate-200">
      <div class="grid lg:grid-cols-12 gap-x-12 gap-y-6">
        <div class="lg:col-span-4">
          <p class="font-code text-xs text-gold-700 mb-3">01</p>
          <h2 id="visi-misi-h" class="font-editorial text-3xl sm:text-4xl font-semibold text-navy-900">Visi &amp; Misi</h2>
        </div>

        <div class="lg:col-span-8 space-y-14">
          <div>
            <h3 class="font-sans text-xs font-bold uppercase tracking-[0.18em] text-slate-600 mb-4">Visi Program Studi</h3>
            <blockquote class="border-l-4 border-gold-600 pl-6">
              <p class="font-editorial text-2xl sm:text-3xl leading-snug text-navy-900">{visi}</p>
            </blockquote>
          </div>

          <div>
            <h3 class="font-sans text-xs font-bold uppercase tracking-[0.18em] text-slate-600 mb-2">Misi Program Studi</h3>
            <ol class="divide-y divide-slate-200">
              {misi.map((m, i) => (
                <li class="flex gap-5 sm:gap-8 py-6">
                  <span class="font-editorial text-4xl sm:text-5xl leading-none text-gold-700 w-10 sm:w-14 shrink-0" aria-hidden="true">{i + 1}</span>
                  <p class="text-base sm:text-lg text-slate-700 leading-relaxed">{m}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    {/* 02 Sambutan */}
    <section id="sambutan" aria-labelledby="sambutan-h" class="scroll-mt-40 py-16 sm:py-24 border-b border-slate-200">
      <div class="grid lg:grid-cols-12 gap-x-12 gap-y-6">
        <div class="lg:col-span-4">
          <p class="font-code text-xs text-gold-700 mb-3">02</p>
          <h2 id="sambutan-h" class="font-editorial text-3xl sm:text-4xl font-semibold text-navy-900">Sambutan Kaprodi &amp; Dekan</h2>
        </div>

        <article class="lg:col-span-8">
          <div class="space-y-5 text-base sm:text-lg text-slate-700 leading-relaxed max-w-prose">
            <p>
              Selamat datang di portal resmi Program Studi S1 Sistem Informasi, Fakultas Ilmu Komputer, Universitas Darwan Ali. Di tengah laju kecerdasan buatan dan integrasi data global, tantangan kita adalah mencetak sarjana yang tidak hanya menguasai perkakas teknologi, tetapi juga berintegritas, analitis, dan adaptif terhadap persoalan nyata bangsa.
            </p>
            <p>
              Kurikulum Outcome-Based Education (OBE) 144 SKS yang terstruktur dan terukur, bersama lima kelompok riset dosen, kami gunakan untuk membekali mahasiswa dengan kapabilitas riset, rekayasa proses bisnis, dan kecakapan AI yang siap bersaing di tingkat nasional maupun internasional.
            </p>
          </div>

          <footer class="mt-10 pt-6 border-t border-slate-200">
            <p class="font-editorial text-xl font-semibold text-navy-900">Dr. Dwi Wahyu Prabowo, S.Si., M.Eng.</p>
            <p class="mt-1 text-sm text-slate-600">Ketua Program Studi S1 Sistem Informasi &amp; Dekan Fakultas Ilmu Komputer</p>
            <p class="mt-1 font-code text-xs text-slate-600">NUPTK 4536767668130283</p>
            <a
              href="http://bowo.staff.unda.ac.id/"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-flex items-center min-h-[48px] px-6 bg-navy-900 text-white text-sm font-semibold rounded hover:bg-navy-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-600 focus-visible:ring-offset-2 transition-colors"
            >
              Laman staf: bowo.staff.unda.ac.id
              <span class="sr-only"> (membuka tab baru)</span>
              <span aria-hidden="true" class="ml-2">↗</span>
            </a>
          </footer>
        </article>
      </div>
    </section>

    {/* 03 Struktur */}
    <section id="struktur" aria-labelledby="struktur-h" class="scroll-mt-40 py-16 sm:py-24 border-b border-slate-200">
      <div class="grid lg:grid-cols-12 gap-x-12 gap-y-6">
        <div class="lg:col-span-4">
          <p class="font-code text-xs text-gold-700 mb-3">03</p>
          <h2 id="struktur-h" class="font-editorial text-3xl sm:text-4xl font-semibold text-navy-900">Struktur Organisasi</h2>
        </div>

        <div class="lg:col-span-8">
          <div class="bg-navy-900 text-white rounded px-6 py-7 sm:px-8">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-gold-500">Dekan &amp; Ketua Program Studi SI</p>
            <p class="mt-2 font-editorial text-2xl sm:text-3xl font-semibold">Dr. Dwi Wahyu Prabowo, S.Si., M.Eng.</p>
          </div>

          <dl class="divide-y divide-slate-200 border-b border-slate-200">
            {struktur.map((s) => (
              <div class="grid sm:grid-cols-5 gap-x-8 gap-y-1 py-5 px-1">
                <dt class="sm:col-span-2 text-sm font-semibold text-slate-600">{s.role}</dt>
                <dd class="sm:col-span-3 font-editorial text-lg text-navy-900">{s.name}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>
  </div>

  {/* 04 Akreditasi */}
  <section id="akreditasi" aria-labelledby="akreditasi-h" class="scroll-mt-20 bg-navy-900 text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 grid lg:grid-cols-12 gap-x-12 gap-y-8 items-end">
      <div class="lg:col-span-4">
        <p class="font-code text-xs text-gold-500 mb-3">04</p>
        <h2 id="akreditasi-h" class="font-editorial text-3xl sm:text-4xl font-semibold">Status Akreditasi</h2>
      </div>
      <div class="lg:col-span-8">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-300">Peringkat</p>
        <p class="mt-2 font-editorial text-5xl sm:text-7xl font-semibold text-gold-500 leading-none">Baik Sekali</p>
        <p class="mt-6 max-w-xl text-base sm:text-lg text-slate-300 leading-relaxed">
          Terakreditasi oleh LAM INFOKOM / BAN-PT.
        </p>
        <a
          href="/en/about/#accreditation"
          hreflang="en"
          class="mt-8 inline-flex items-center min-h-[48px] px-6 border border-gold-500 text-gold-500 text-sm font-semibold rounded hover:bg-gold-500 hover:text-navy-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-300 focus-visible:ring-offset-2 focus-visible:ring-offset-navy-900 transition-colors"
        >
          Read in English
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
