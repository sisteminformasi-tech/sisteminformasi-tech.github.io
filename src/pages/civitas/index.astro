---
import BaseLayout from '../../layouts/BaseLayout.astro';
import civitas from '../../data/civitas.json';

const { faculty, assistants } = civitas;
---

<BaseLayout
  title="Civitas Akademika — Program Studi S1 Sistem Informasi"
  description="Direktori profil akademik 11 Dosen Tetap ber-NUPTK dan 3 Asisten Dosen Program Studi S1 Sistem Informasi, Fakultas Ilmu Komputer, Universitas Darwan Ali."
  lang="id"
>
  {/* Header */}
  <section class="bg-navy-900 text-white border-b border-navy-800 py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-navy-950 border border-gold-500/40 text-xs font-semibold text-gold-300 mb-4">
          <span>Sumber Daya Manusia (SDM) Akademik</span>
          <span class="text-slate-600">·</span>
          <span>11 Dosen Tetap & 3 Asisten Dosen</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-editorial tracking-tight text-white mb-4">
          Civitas Akademika & Tenaga Pendidik
        </h1>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Para akademisi dan peneliti berdedikasi tinggi di Program Studi S1 Sistem Informasi FIK Universitas Darwan Ali. Memiliki kualifikasi lulusan perguruan tinggi terkemuka, terdaftar resmi dengan NUPTK, aktif dalam riset internasional bereputasi, dan berorientasi pada kemajuan mahasiswa.
        </p>
      </div>

      <div class="mt-8 pt-6 border-t border-navy-800/80 flex flex-wrap gap-2 text-xs">
        <a href="#dosen" class="px-3 py-1.5 rounded bg-gold-500 hover:bg-gold-600 text-white font-bold transition-colors">
          ↓ Direktori Dosen Tetap ({faculty.length})
        </a>
        <a href="#asdos" class="px-3 py-1.5 rounded bg-navy-800 hover:bg-navy-700 text-slate-200 transition-colors">
          ↓ Asisten Dosen (3)
        </a>
        <a href="/riset/kelompok-riset/" class="px-3 py-1.5 rounded border border-gold-500/50 text-gold-400 hover:bg-navy-800 transition-colors">
          Kelompok Studi Riset Dosen ↗
        </a>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    
    {/* Section 1: Dosen Tetap */}
    <section id="dosen" class="scroll-mt-24">
      <div class="border-b border-slate-200 pb-4 mb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-gold-600 block">Dosen Homebase</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 font-editorial">
          Direktori {faculty.length} Dosen Tetap Program Studi
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Dosen tetap berkualifikasi S2 dan S3 yang membimbing kurikulum OBE, perkuliahan, dan payung penelitian skripsi mahasiswa.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {faculty.map((doc) => (
          <div class="card-academic p-6 flex flex-col justify-between group hover:border-gold-500 transition-all">
            <div>
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl border-2 border-gold-500/80 shadow-md overflow-hidden bg-navy-950 flex items-center justify-center shrink-0 text-gold-400 font-editorial font-bold text-3xl">
                  {doc.image ? (
                    <img src={doc.image} alt={doc.name} class="w-full h-full object-cover object-top" loading="lazy" />
                  ) : (
                    <>{doc.name.charAt(0)}</>
                  )}
                </div>
                <div class="text-right">
                  <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-slate-700 mb-1">
                    {doc.functional_rank || 'Dosen Tetap'}
                  </span>
                  <span class="block text-[10px] font-code text-slate-500">
                    NUPTK: {doc.nuptk || '-'}
                  </span>
                </div>
              </div>

              <h3 class="text-base font-bold text-navy-900 font-editorial leading-snug mb-1 group-hover:text-gold-700 transition-colors">
                <a href={`/civitas/dosen/${doc.slug}/`}>
                  {doc.name}
                </a>
              </h3>

              <p class="text-xs text-slate-500 mb-3">
                {doc.position || 'Dosen Tetap S1 Sistem Informasi'}
              </p>

              {/* Pendidikan Terakhir */}
              {doc.education && doc.education.length > 0 && (
                <div class="text-xs text-slate-600 mb-3 line-clamp-2">
                  <strong class="text-slate-800">Almamater:</strong> {doc.education[doc.education.length - 1]}
                </div>
              )}

              {/* Keahlian Tags */}
              <div class="flex flex-wrap gap-1 mb-4">
                {doc.expertise.slice(0, 3).map((exp: string) => (
                  <span class="px-2 py-0.5 rounded bg-slate-50 border border-slate-200 text-slate-700 text-[10px]">
                    {exp}
                  </span>
                ))}
                {doc.expertise.length > 3 && (
                  <span class="px-1.5 py-0.5 text-slate-400 text-[10px]">
                    +{doc.expertise.length - 3} lainnya
                  </span>
                )}
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <a
                href={`/civitas/dosen/${doc.slug}/`}
                class="text-xs font-bold text-navy-900 hover:text-gold-700 inline-flex items-center transition-colors"
              >
                Lihat Profil Lengkap →
              </a>
              {doc.sinta_url && (
                <a
                  href={doc.sinta_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[11px] font-code text-gold-700 hover:underline"
                >
                  SINTA ↗
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* Section 2: Asisten Dosen */}
    <section id="asdos" class="scroll-mt-24">
      <div class="border-b border-slate-200 pb-4 mb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-gold-600 block">Staf Pendukung Akademik</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 font-editorial">
          3 Asisten Dosen & Pengelola Laboratorium
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Mendukung praktikum komputer, pendampingan perkuliahan, pengelolaan portal MBKM, dan asistensi teknis riset prodi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {assistants.map((asdos) => (
          <div class="card-academic p-6 flex flex-col justify-between group hover:border-gold-500 transition-all">
            <div>
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="w-12 h-12 rounded-full bg-slate-800 border-2 border-gold-400 flex items-center justify-center text-white font-editorial font-bold text-lg overflow-hidden">
                  {asdos.image ? (
                    <img src={asdos.image} alt={asdos.name} class="w-full h-full object-cover object-top" loading="lazy" />
                  ) : (
                    <>{asdos.name.charAt(0)}</>
                  )}
                </div>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-gold-50 text-gold-800 border border-gold-200">
                  Asisten Dosen
                </span>
              </div>

              <h3 class="text-base font-bold text-navy-900 font-editorial leading-snug mb-1 group-hover:text-gold-700 transition-colors">
                <a href={`/civitas/asdos/${asdos.slug}/`}>
                  {asdos.name}
                </a>
              </h3>

              <p class="text-xs text-slate-500 mb-3">
                {asdos.position || 'Asisten Dosen S1 Sistem Informasi'}
              </p>

              <div class="flex flex-wrap gap-1 mb-4">
                {asdos.expertise.slice(0, 3).map((exp: string) => (
                  <span class="px-2 py-0.5 rounded bg-slate-50 border border-slate-200 text-slate-700 text-[10px]">
                    {exp}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
              <a
                href={`/civitas/asdos/${asdos.slug}/`}
                class="text-xs font-bold text-navy-900 hover:text-gold-700 inline-flex items-center transition-colors"
              >
                Lihat Profil Asisten →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
