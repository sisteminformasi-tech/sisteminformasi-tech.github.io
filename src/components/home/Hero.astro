---
interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;
import navigation from '../../data/navigation.json';
const isEn = lang === 'en';
const spmb = navigation.portals.find(p => p.featured) || navigation.portals[0];
---

<section class="relative bg-navy-900 text-white overflow-hidden border-b border-navy-800">
  {/* Institutional Subtle Grid Pattern */}
  <div class="absolute inset-0 opacity-5 bg-[radial-gradient(#C5A880_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      {/* Left Column: Headlines & Call to Actions */}
      <div class="lg:col-span-8 space-y-6">
        {/* Accreditation & Faculty Badge */}
        <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-navy-950/80 border border-gold-500/40 text-xs font-semibold text-gold-300">
          <span class="w-2 h-2 rounded-full bg-gold-400 animate-pulse"></span>
          <span>{isEn ? 'Faculty of Computer Science · Universitas Darwan Ali' : 'Fakultas Ilmu Komputer · Universitas Darwan Ali'}</span>
          <span class="text-slate-600">|</span>
          <span class="text-slate-300">{isEn ? 'Accredited: Baik Sekali' : 'Akreditasi: Baik Sekali'}</span>
        </div>

        {/* Main Editorial Display Title */}
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight font-editorial">
          {isEn ? (
            <>
              Innovating in <span class="text-gold-400">Artificial Intelligence</span> & Enterprise Systems.
            </>
          ) : (
            <>
              Unggul dalam <span class="text-gold-400">Kecerdasan Buatan</span>, Sains Data & Sistem Enterprise.
            </>
          )}
        </h1>

        {/* Subtitle / Value Proposition */}
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
          {isEn
            ? 'The Undergraduate Program in Information Systems prepares future-ready leaders and tech architects through an Outcome-Based Education (OBE) curriculum with 144 credits, rigorous research, and real-world industrial relevance.'
            : 'Program Studi S1 Sistem Informasi menyelenggarakan pendidikan berstandar Outcome-Based Education (OBE) dengan total 144 SKS, memadukan riset bio-signal & AI terdepan dengan rekayasa sistem enterprise untuk menjawab kebutuhan transformasi digital bangsa.'}
        </p>

        {/* Action Buttons */}
        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a
            href={spmb.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-md bg-gold-500 hover:bg-gold-600 text-navy-950 font-bold text-sm uppercase tracking-wider shadow-md hover:shadow-lg transition-all duration-150 transform hover:-translate-y-0.5 touch-target"
          >
            {isEn ? 'Apply for SPMB 2026' : 'Pendaftaran SPMB Online'}
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href={isEn ? '/en/academics/curriculum/' : '/akademik/kurikulum/'}
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-md bg-navy-800 hover:bg-navy-700 text-slate-200 hover:text-white border border-slate-700 hover:border-gold-500/50 font-semibold text-sm transition-all duration-150 touch-target"
          >
            {isEn ? 'Explore Curriculum (144 SKS)' : 'Lihat Kurikulum OBE 144 SKS'}
          </a>

          <a
            href={isEn ? '/en/academics/rps/' : '/akademik/rps/'}
            class="inline-flex items-center justify-center px-4 py-3.5 text-gold-400 hover:text-gold-300 text-sm font-semibold hover:underline"
          >
            {isEn ? 'Download RPS PDF →' : 'Repositori RPS PDF →'}
          </a>
        </div>
      </div>

      {/* Right Column: Key Academic Metrics Card */}
      <div class="lg:col-span-4">
        <div class="bg-navy-950/90 border border-navy-800 rounded-xl p-6 sm:p-8 shadow-xl relative backdrop-blur">
          <div class="absolute -top-3 right-6 bg-gold-500 text-navy-950 font-bold text-[10px] uppercase px-2.5 py-1 rounded shadow">
            OBE Standard
          </div>
          
          <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-6 pb-2 border-b border-navy-800">
            {isEn ? 'Program Fast Facts' : 'Sekilas Informasi Akademik'}
          </h3>

          <div class="space-y-5">
            <div class="flex items-center justify-between pb-3 border-b border-navy-800/80">
              <span class="text-xs text-slate-400">{isEn ? 'Total Credits to Graduate' : 'Beban Studi Kelulusan'}</span>
              <span class="font-code font-bold text-gold-400 text-base">144 SKS</span>
            </div>

            <div class="flex items-center justify-between pb-3 border-b border-navy-800/80">
              <span class="text-xs text-slate-400">{isEn ? 'Study Period' : 'Masa Studi Rata-Rata'}</span>
              <span class="font-bold text-slate-200 text-sm">{isEn ? '8 Semesters (4 Years)' : '8 Semester (4 Tahun)'}</span>
            </div>

            <div class="flex items-center justify-between pb-3 border-b border-navy-800/80">
              <span class="text-xs text-slate-400">{isEn ? 'Degree Awarded' : 'Gelar Kesarjanaan'}</span>
              <span class="font-bold text-slate-200 text-sm">S.Kom. (Sarjana Komputer)</span>
            </div>

            <div class="flex items-center justify-between pb-3 border-b border-navy-800/80">
              <span class="text-xs text-slate-400">{isEn ? 'Research Clusters' : 'Klaster Studi Riset'}</span>
              <span class="font-code font-bold text-gold-400 text-base">5 Kelompok</span>
            </div>

            <div class="flex items-center justify-between">
              <span class="text-xs text-slate-400">{isEn ? 'Full-time Faculty' : 'Dosen Tetap Ber-NUPTK'}</span>
              <span class="font-code font-bold text-slate-200 text-base">12 Dosen</span>
            </div>
          </div>

          <div class="mt-6 pt-5 border-t border-navy-800">
            <a
              href="http://bowo.staff.unda.ac.id/"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center text-xs text-gold-400 hover:text-gold-300 font-medium py-2 px-3 rounded bg-navy-900 border border-gold-500/30 hover:border-gold-400 transition-colors"
            >
              <span>{isEn ? 'Dean & Program Head Profile →' : 'Profil Kaprodi & Dekan (Dr. Dwi) →'}</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
