---
import { getCourse, formatPl, type Lang } from '../../lib/mbkm';

interface Props {
  codes: string[];
  lang: Lang;
  showPl?: boolean;
}

const { codes, lang, showPl = false } = Astro.props;
const rpsBase = lang === 'en' ? '/en/academics/rps/' : '/akademik/rps/';
const unit = lang === 'en' ? 'credits' : 'SKS';
---

<ul class="divide-y divide-slate-100">
  {codes.map((code) => {
    const c = getCourse(code);
    return (
      <li class="flex items-baseline gap-3 px-4 py-2.5">
        <a
          href={`${rpsBase}?q=${encodeURIComponent(c.code)}`}
          class="font-code text-[11px] font-bold text-navy-900 hover:text-gold-700 underline decoration-slate-300 underline-offset-2 shrink-0 w-[4.75rem]"
          title={lang === 'en' ? `Syllabus for ${c.name}` : `RPS ${c.name}`}
        >
          {c.code}
        </a>
        <span class="flex-1 text-[13px] text-slate-800 leading-snug">
          {c.name}
          {showPl && (
            <span class="block font-code text-[10px] text-slate-500 mt-0.5">{formatPl(c.pl)}</span>
          )}
        </span>
        <span class="font-code text-[11px] font-bold text-gold-700 shrink-0">{c.sks} {unit}</span>
      </li>
    );
  })}
</ul>
