---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import civitas from '../../../data/civitas.json';

export function getStaticPaths() {
  return civitas.assistants.map((asdos) => ({
    params: { slug: asdos.slug },
    props: { asdos },
  }));
}

const { asdos } = Astro.props;
---

<BaseLayout
  title={`${asdos.name} — Asisten Dosen Sistem Informasi`}
  description={`Profil akademik ${asdos.name}, Asisten Dosen dan Tenaga Akademik Program Studi Sistem Informasi Universitas Darwan Ali.`}
  lang="id"
>
  {/* Header */}
  <section class="bg-navy-900 text-white border-b border-navy-800 py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center space-x-2 text-xs text-slate-400 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gold-400">Beranda</a>
        <span>›</span>
        <a href="/civitas/" class="hover:text-gold-400">Civitas Akademika</a>
        <span>›</span>
        <a href="/civitas/#asdos" class="hover:text-gold-400">Asisten Dosen</a>
        <span>›</span>
        <span class="text-slate-200">{asdos.name}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-3 flex justify-center lg:justify-start">
          <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl border-4 border-gold-500 shadow-xl overflow-hidden bg-navy-950 flex items-center justify-center text-gold-400 font-editorial font-bold text-5xl">
            {asdos.image ? (
              <img src={asdos.image} alt={asdos.name} class="w-full h-full object-cover object-center" loading="lazy" />
            ) : (
              <>{asdos.name.charAt(0)}</>
            )}
          </div>
        </div>

        <div class="lg:col-span-9 space-y-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-1 bg-gold-500 text-white font-bold text-xs uppercase tracking-wider rounded">
              Asisten Dosen
            </span>
            <span class="px-2.5 py-1 bg-navy-950 text-slate-300 font-code text-xs rounded border border-navy-800">
              Tenaga Akademik & Praktikum
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-bold font-editorial text-white tracking-tight">
            {asdos.name}
          </h1>

          <p class="text-sm sm:text-base text-slate-300 font-medium">
            {asdos.position || 'Asisten Dosen Sistem Informasi'} — Fakultas Ilmu Komputer, Universitas Darwan Ali
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-3xl mx-auto space-y-8">
      
      {/* Profil Akademik & Peran */}
      <div class="card-academic p-6 sm:p-8">
        <h2 class="text-lg font-bold text-navy-900 font-editorial border-b border-slate-200 pb-3 mb-4">
          Tugas Pokok & Peran Asistensi
        </h2>
        <div class="text-xs sm:text-sm text-slate-700 leading-relaxed space-y-3">
          {asdos.slug.includes('dody') && (
            <>
              <p>
                <strong>Dody Erlangga, S.Kom.</strong> adalah alumni sarjana Sistem Informasi Universitas Darwan Ali yang berfokus pada pengembangan Multimedia, Pemrograman Mobile (Flutter/Dart), dan Internet of Things (IoT).
              </p>
              <p>
                Beliau bertugas sebagai pengelola portal informasi akademik prodi, asisten praktikum laboratorium komputer, dan pendamping teknis program Merdeka Belajar Kampus Merdeka (MBKM) serta saat ini menempuh studi lanjut Magister Komputer (S2 M.Kom.).
              </p>
            </>
          )}

          {asdos.slug.includes('fauzan') && (
            <>
              <p>
                <strong>Fauzan Eka Prasatia, S.M.</strong> memiliki kepakaran di bidang Transformasi Digital, Manajemen Sistem Informasi, Kepemimpinan Digital, dan Pengembangan Kapasitas Organisasi.
              </p>
              <p>
                Aktif menulis buku ajar dan buku referensi di bidang kepemimpinan era digital, beliau mendampingi perkuliahan rumpun manajemen organisasi dan sistem enterprise, serta asistensi tata kelola dokumen akreditasi prodi.
              </p>
            </>
          )}

          {asdos.slug.includes('prio') && (
            <>
              <p>
                <strong>Prio Jaka Arsyad, S.Kom.</strong> memiliki kepakaran teknis di bidang Rekayasa Perangkat Lunak, Basis Data Relasional & NoSQL, serta Integrasi Sistem Enterprise.
              </p>
              <p>
                Beliau mendampingi kegiatan praktikum pemrograman, asistensi administrasi perkuliahan kelas malam dan pekerja, serta mendukung riset operasional laboratorium komputasi Fakultas Ilmu Komputer.
              </p>
            </>
          )}
        </div>
      </div>

      {/* Bidang Keahlian */}
      <div class="card-academic p-6 sm:p-8">
        <h2 class="text-lg font-bold text-navy-900 font-editorial border-b border-slate-200 pb-3 mb-4">
          Bidang Keahlian Teknis
        </h2>
        <div class="flex flex-wrap gap-2">
          {asdos.expertise.map((exp: string) => (
            <span class="px-3 py-1.5 rounded bg-slate-100 text-navy-900 text-xs font-semibold border border-slate-200">
              {exp}
            </span>
          ))}
        </div>
      </div>

      {/* Back Button */}
      <div class="text-center pt-4">
        <a
          href="/civitas/#asdos"
          class="inline-flex items-center text-xs font-bold text-navy-900 hover:text-gold-700 underline"
        >
          ← Kembali ke Direktori Asisten Dosen
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
