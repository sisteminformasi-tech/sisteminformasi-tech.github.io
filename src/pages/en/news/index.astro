---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const newsItems = [
  {
    title: 'Socialization of 144-Credit OBE Curriculum for Incoming Information Systems Students',
    date: '15 November 2026',
    category: 'Academics',
    author: 'IS Admin Office',
    summary: 'The program outlines graduate learning outcomes (CPL), specialization pathways, and output-oriented thesis workflows for the 2026 cohort.',
    content: 'To foster comprehensive awareness of higher education curriculum transformations, the Undergraduate Program in Information Systems held an orientation session for its 144-Credit Outcome-Based Education (OBE) framework. Attended by faculty leadership, academic advisors, and new students, Program Head Dr. Dwi Wahyu Prabowo stressed the imperative of analytical competency, artificial intelligence ethics, and rigorous independent inquiry as foundations for succeeding in modern digital markets.'
  },
  {
    title: 'Information Systems Faculty Publishes Flagship Scopus Q1 Article in EEG & AI Emotion Recognition',
    date: '02 November 2026',
    category: 'Research',
    author: 'AIML-RG Research Group',
    summary: 'Landmark research on Multi-Domain CNN and Recurrence Plots for human emotion classification is published in IEEE Access.',
    content: 'The Artificial Intelligence & Machine Learning Research Group (AIML-RG) celebrated a major scholarly milestone with the publication of "Enhancing EEG-Based Emotion Recognition Using Asymmetric Windowing Recurrence Plots" in IEEE Access (Scopus Q1). The paper formulates non-linear electroencephalogram signal transformations into 2D recurrence matrices to significantly improve deep learning inference accuracy.'
  },
  {
    title: 'Briefing for Certified MBKM Industrial Internship and Independent Study Cohort 2026',
    date: '24 October 2026',
    category: 'Student Affairs',
    author: 'MBKM Directorate',
    summary: '35 Information Systems students prepare for full-semester placements across corporate partners and regional government agencies.',
    content: 'The Faculty of Computer Science conducted intensive onboarding for students participating in certified Kampus Merdeka (MBKM) programs. The workshop addressed professional workplace ethics, corporate data protection guidelines, and the standardized 20-credit academic transcript conversion policy for semesters 6 and 7.'
  },
  {
    title: 'Human-Centered Design UI/UX Workshop for Regional Micro-Enterprises',
    date: '12 October 2026',
    category: 'Community Service',
    author: 'MHUI-RG Research Group',
    summary: 'Multimedia and UI/UX faculty deliver hands-on digital branding and prototyping mentorship for 40 local micro-business operators.',
    content: 'Translating academic expertise into community impact, faculty from the MHUI-RG cluster hosted a practical design sprint for 40 MSME owners in Kotawaringin Timur. Participants built interactive e-commerce mobile mockups adhering to web accessibility and visual contrast standards.'
  }
];
---

<BaseLayout
  title="News & Events — Information Systems Program"
  description="Latest news, scientific breakthroughs, student accomplishments, and academic circulars from the Information Systems Program at Universitas Darwan Ali."
  lang="en"
>
  <section class="bg-navy-900 text-white border-b border-navy-800 py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-navy-950 border border-gold-500/40 text-xs font-semibold text-gold-300 mb-4">
          <span>Campus Bulletin & Scholarly News</span>
          <span class="text-slate-600">·</span>
          <span>Official Dispatch</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-editorial tracking-tight text-white mb-4">
          News & Academic Circulars
        </h1>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Chronicle of scholarly publications, research milestones, student competitions, and administrative announcements from the Information Systems Program at Universitas Darwan Ali.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {newsItems.map((item) => (
        <article class="card-academic p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-xs text-slate-500 mb-3 pb-3 border-b border-slate-100">
              <span class="px-2.5 py-0.5 rounded font-bold uppercase tracking-wider text-[10px] bg-slate-100 text-slate-700">
                {item.category}
              </span>
              <span>{item.date}</span>
            </div>

            <h2 class="text-lg sm:text-xl font-bold text-navy-900 font-editorial mb-3 leading-snug">
              {item.title}
            </h2>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
              {item.content}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-400 font-medium">By: {item.author}</span>
            <span class="font-bold text-gold-700">Verified Notice</span>
          </div>
        </article>
      ))}
    </div>

  </div>
</BaseLayout>
