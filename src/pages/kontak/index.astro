---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kontak & Lokasi Kampus — Program Studi Sistem Informasi"
  description="Sekretariat Program Studi Sistem Informasi, Fakultas Ilmu Komputer, Universitas Darwan Ali. Lokasi kampus di Sampit, Kotawaringin Timur, email, dan layanan informasi."
  lang="id"
>
  <section class="bg-navy-900 text-white border-b border-navy-800 py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-md bg-navy-950 border border-navy-800 text-xs font-semibold text-gold-300 mb-4">
          <span>Sekretariat & Hubungan Masyarakat</span>
          <span class="text-slate-600">·</span>
          <span>Layanan Informasi Terpadu</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-editorial tracking-tight text-white mb-4">
          Kontak & Lokasi Kampus
        </h1>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Hubungi sekretariat Program Studi Sistem Informasi untuk keperluan informasi pendaftaran, kerjasama riset industri, pengabdian masyarakat, atau layanan administrasi akademik.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      {/* Form Kontak */}
      <div class="lg:col-span-7 card-academic p-8 border-slate-200">
        <h2 class="text-xl font-bold text-navy-900 font-editorial border-b border-slate-200 pb-3 mb-6">
          Kirimkan Pesan atau Pertanyaan
        </h2>

        <form action="mailto:sisteminformasi@unda.ac.id" method="post" enctype="text/plain" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Nama Lengkap *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Nama Anda..."
                class="w-full px-3.5 py-2.5 rounded-md border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-gold-500"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Alamat Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="nama@email.com"
                class="w-full px-3.5 py-2.5 rounded-md border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-gold-500"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
              Subjek Pesan *
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              placeholder="Contoh: Informasi Pendaftaran / Kerjasama Riset"
              class="w-full px-3.5 py-2.5 rounded-md border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-gold-500"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
              Isi Pesan *
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Tuliskan pesan atau pertanyaan Anda secara rinci..."
              class="w-full px-3.5 py-2.5 rounded-md border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-gold-500"
            ></textarea>
          </div>

          <button
            type="submit"
            class="inline-flex items-center justify-center px-6 py-3 rounded bg-navy-900 hover:bg-gold-500 text-white hover:text-white font-bold text-xs uppercase tracking-wider shadow-sm transition-colors"
          >
            Kirimkan Pesan Sekarang
          </button>
        </form>
      </div>

      {/* Informasi Kontak & Lokasi */}
      <div class="lg:col-span-5 space-y-6">
        
        <div class="card-academic p-6 space-y-4">
          <h3 class="flex items-center gap-2 text-sm font-bold text-navy-900 uppercase tracking-wider border-b border-slate-200 pb-2">
            <svg class="w-4 h-4 text-gold-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5" stroke-width="1.8"/></svg>
            Alamat Kampus Utama
          </h3>
          <p class="text-xs text-slate-700 leading-relaxed">
            <strong>Fakultas Ilmu Komputer — Universitas Darwan Ali</strong><br />
            Jl. Batu Berlian No. 10, Kel. Mentawa Baru Hulu, Kec. Mentawa Baru Ketapang, Kab. Kotawaringin Timur, Kalimantan Tengah 74322, Indonesia.
          </p>
        </div>

        <div class="card-academic p-6 space-y-3">
          <h3 class="flex items-center gap-2 text-sm font-bold text-navy-900 uppercase tracking-wider border-b border-slate-200 pb-2">
            <svg class="w-4 h-4 text-gold-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Kanal Komunikasi Resmi
          </h3>
          <div class="text-xs space-y-3 text-slate-700">
            <div class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-gold-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <div class="min-w-0">
                <span class="text-slate-400 block text-[11px]">Email Resmi Prodi:</span>
                <a href="mailto:sisteminformasi@unda.ac.id" class="text-gold-700 font-semibold hover:underline break-words">sisteminformasi@unda.ac.id</a>
              </div>
            </div>
            <div class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-gold-700 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 00-8.5 15l-1.5 5 5.2-1.4A9.9 9.9 0 1012.04 2zm5.8 14.1c-.25.7-1.4 1.3-1.9 1.35-.5.05-1.1.07-1.8-.12a14 14 0 01-5.3-3.2 9.7 9.7 0 01-2-3.1c-.3-1.1.1-2 .7-2.6.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.6-.3.4c-.1.2-.2.3 0 .6a8 8 0 002.4 2.2c.4.2.7.2.9 0l.6-.7c.2-.2.4-.2.6-.1l1.8.9c.2.1.4.2.4.3.1.2.1.8-.2 1.5z"/></svg>
              <div class="min-w-0">
                <span class="text-slate-400 block text-[11px]">WhatsApp Resmi:</span>
                <a href="https://wa.me/6282358393889" target="_blank" rel="noopener noreferrer" class="text-gold-700 font-semibold hover:underline break-words">+62 823-5839-3889</a>
              </div>
            </div>
            <div class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-gold-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke-width="1.8"/><circle cx="12" cy="12" r="4" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
              <div class="min-w-0">
                <span class="text-slate-400 block text-[11px]">Instagram Resmi:</span>
                <a href="https://www.instagram.com/sisfounda/" target="_blank" rel="noopener noreferrer" class="text-gold-700 font-semibold hover:underline break-words">@sisfounda</a>
              </div>
            </div>
            <div class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-gold-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1"/></svg>
              <div class="min-w-0">
                <span class="text-slate-400 block text-[11px]">Portal eSign Fakultas:</span>
                <a href="https://esign-fikom.unda.ac.id/" target="_blank" rel="noopener noreferrer" class="text-gold-700 font-semibold hover:underline break-words">esign-fikom.unda.ac.id</a>
              </div>
            </div>
          </div>
        </div>

        <div class="card-academic p-6 bg-slate-50 border-slate-200">
          <h4 class="flex items-center gap-2 text-xs font-bold text-navy-900 uppercase tracking-wider mb-2">
            <svg class="w-4 h-4 text-gold-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="1.8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 7v5l3 2"/></svg>
            Jam Operasional Layanan Sekretariat
          </h4>
          <ul class="text-xs text-slate-600 space-y-1">
            <li><strong>Senin – Kamis:</strong> 08:00 – 16:00 WIB</li>
            <li><strong>Jumat:</strong> 08:00 – 11:30 & 13:00 – 16:30 WIB</li>
            <li><strong>Sabtu (Kelas Karyawan):</strong> 09:00 – 17:00 WIB</li>
            <li><strong>Minggu & Hari Libur Nasional:</strong> Tutup</li>
          </ul>
        </div>

      </div>

    </div>
  </div>
</BaseLayout>
