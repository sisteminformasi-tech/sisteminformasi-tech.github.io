---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Student Services & Guidelines — Information Systems Program"
  description="Student affairs and academic services for Information Systems at Universitas Darwan Ali. OBE Thesis SOP, Internships (KP/MBKM), and Student Association (HIMASI)."
  lang="en"
>
  <section class="bg-navy-900 text-white border-b border-navy-800 py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-navy-950 border border-gold-500/40 text-xs font-semibold text-gold-300 mb-4">
          <span>Student Affairs & Academic Services</span>
          <span class="text-slate-600">·</span>
          <span>SOP & Extracurriculars</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-editorial tracking-tight text-white mb-4">
          Student Services & Guidelines
        </h1>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Integrated hub for academic standard operating procedures (SOP), Outcome-Based Education thesis roadmaps, certified industry internships, student leadership activities (HIMASI), and digital administrative portals.
        </p>
      </div>

      <div class="mt-8 pt-6 border-t border-navy-800/80 flex flex-wrap gap-2 text-xs">
        <a href="#sop" class="px-3 py-1.5 rounded bg-navy-800 hover:bg-navy-700 text-slate-200">↓ Academic SOP</a>
        <a href="#thesis" class="px-3 py-1.5 rounded bg-gold-500 text-navy-950 font-bold hover:bg-gold-600">↓ Capstone Thesis</a>
        <a href="#internships" class="px-3 py-1.5 rounded bg-navy-800 hover:bg-navy-700 text-slate-200">↓ Internships</a>
        <a href="#himasi" class="px-3 py-1.5 rounded bg-navy-800 hover:bg-navy-700 text-slate-200">↓ HIMASI Association</a>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    
    {/* Academic SOP */}
    <section id="sop" class="scroll-mt-24">
      <div class="border-b border-slate-200 pb-4 mb-6">
        <span class="text-xs font-bold uppercase tracking-wider text-gold-600 block">Academic Procedures</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 font-editorial">
          Standard Operating Procedures (SOP)
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card-academic p-6">
          <div class="w-10 h-10 rounded-lg bg-navy-100 text-navy-900 flex items-center justify-center font-bold mb-4">
            01
          </div>
          <h3 class="text-base font-bold text-navy-900 font-editorial mb-2">
            Course Enrollment & Academic Advisor
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            Conducted at the start of each semester via SIAKAD Cloud. Students consult their academic advisor regarding prerequisite courses and credit allocation.
          </p>
          <a href="https://siak.unda.ac.id/" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-gold-700 hover:underline">
            Access SIAKAD ↗
          </a>
        </div>

        <div class="card-academic p-6">
          <div class="w-10 h-10 rounded-lg bg-navy-100 text-navy-900 flex items-center justify-center font-bold mb-4">
            02
          </div>
          <h3 class="text-base font-bold text-navy-900 font-editorial mb-2">
            Internships & Field Work
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            Eligible upon completing 90 credits. Students intern at government agencies, SOEs, or private corporations for 1–3 months with partner mentor assessments.
          </p>
          <a href="/en/downloads/" class="text-xs font-bold text-gold-700 hover:underline">
            Download Templates ↗
          </a>
        </div>

        <div class="card-academic p-6">
          <div class="w-10 h-10 rounded-lg bg-navy-100 text-navy-900 flex items-center justify-center font-bold mb-4">
            03
          </div>
          <h3 class="text-base font-bold text-navy-900 font-editorial mb-2">
            Digital Signatures & eSign
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            Application for official research permits, surveys, library clearance certificates, and academic documents is managed online via eSign FIKOM UNDA.
          </p>
          <a href="https://esign-fikom.unda.ac.id/" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-gold-700 hover:underline">
            eSign Portal ↗
          </a>
        </div>
      </div>
    </section>

    {/* Thesis Section */}
    <section id="thesis" class="scroll-mt-24 card-academic p-8 sm:p-10 border-slate-200">
      <div class="border-b border-slate-200 pb-4 mb-6">
        <span class="text-xs font-bold uppercase tracking-wider text-gold-600 block">Capstone Project (SIFC8B01 - 6 Credits)</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 font-editorial">
          Undergraduate Thesis & Research Standards
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Designed as the crowning synthesis of student competency evaluated across four rigorous academic milestones.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="p-4 rounded bg-slate-50 border border-slate-200">
          <span class="font-code text-xs font-bold text-gold-600 block mb-1">Stage 1</span>
          <h4 class="text-xs font-bold text-navy-900 mb-1">Proposal & Advisor Selection</h4>
          <p class="text-[11px] text-slate-600">Matching research interests with the 5 Faculty Research Groups (AIML, Enterprise, HCI, Data Science, EdTech).</p>
        </div>
        <div class="p-4 rounded bg-slate-50 border border-slate-200">
          <span class="font-code text-xs font-bold text-gold-600 block mb-1">Stage 2</span>
          <h4 class="text-xs font-bold text-navy-900 mb-1">Proposal Defense (Sempro)</h4>
          <p class="text-[11px] text-slate-600">Presenting chapters 1–3 before examiners to validate methodology, literature rigor, and novelty.</p>
        </div>
        <div class="p-4 rounded bg-slate-50 border border-slate-200">
          <span class="font-code text-xs font-bold text-gold-600 block mb-1">Stage 3</span>
          <h4 class="text-xs font-bold text-navy-900 mb-1">System Artifact & Findings</h4>
          <p class="text-[11px] text-slate-600">Deploying prototypes, validating AI models, or assessing IT audit outcomes against empirical data.</p>
        </div>
        <div class="p-4 rounded bg-slate-50 border border-slate-200">
          <span class="font-code text-xs font-bold text-gold-600 block mb-1">Stage 4</span>
          <h4 class="text-xs font-bold text-navy-900 mb-1">Final Comprehensive Defense</h4>
          <p class="text-[11px] text-slate-600">Summative examination determining bachelor qualification along with manuscript publication drafts.</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-4 items-center">
        <a
          href="/en/research/groups/#thesis-topics"
          class="inline-flex items-center px-4 py-2.5 rounded bg-navy-900 hover:bg-navy-800 text-white font-bold text-xs uppercase tracking-wider transition-colors"
        >
          Explore Open Thesis Topics →
        </a>
        <a
          href="/en/downloads/"
          class="inline-flex items-center px-4 py-2.5 rounded bg-slate-100 hover:bg-slate-200 text-navy-900 font-semibold text-xs transition-colors"
        >
          Download Thesis LaTeX & Word Templates →
        </a>
      </div>
    </section>

    {/* HIMASI */}
    <section id="himasi" class="scroll-mt-24 card-academic p-8 sm:p-10 border-slate-200">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-gold-600 block">Student Association</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 font-editorial">
            Information Systems Student Association (HIMASI)
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            HIMASI serves as the premier student organization uniting undergraduate Information Systems scholars at Universitas Darwan Ali. The association organizes software bootcamps, IT seminars, community service, and annual digital innovation showcases.
          </p>
          <div class="pt-2 flex items-center space-x-4 text-xs font-semibold">
            <span class="text-slate-700">Official Instagram: <a href="https://www.instagram.com/sisfounda/" target="_blank" rel="noopener noreferrer" class="text-gold-700 hover:underline">@sisfounda</a></span>
          </div>
        </div>

        <div class="lg:col-span-4 bg-slate-50 border border-slate-200 rounded-lg p-6 text-center space-y-3">
          <div class="w-16 h-16 mx-auto rounded-full bg-navy-900 text-gold-400 font-bold font-editorial text-2xl flex items-center justify-center">
            HI
          </div>
          <h4 class="text-sm font-bold text-navy-900">Leadership & Fellowship</h4>
          <p class="text-xs text-slate-500">
            Open to all active undergraduate students to cultivate communication, leadership, and technical team capabilities.
          </p>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
