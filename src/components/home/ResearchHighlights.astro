---
interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;
import groups from '../../data/research_groups.json';
const isEn = lang === 'en';
---

<section class="py-16 bg-[#FAF9F6] border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-gold-600 block mb-1">
          {isEn ? 'Scholarly Impact' : 'Pusat Keunggulan Riset'}
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 tracking-tight font-editorial">
          {isEn ? '5 Faculty Research Groups' : '5 Kelompok Studi Riset Dosen S1 Sistem Informasi'}
        </h2>
      </div>
      <a
        href={isEn ? '/en/research/groups/' : '/riset/kelompok-riset/'}
        class="text-xs font-bold text-gold-700 hover:text-gold-800 hover:underline inline-flex items-center"
      >
        {isEn ? 'Explore All Research Groups & Topics →' : 'Lihat Semua Kelompok & Topik Skripsi Terbuka →'}
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {groups.map((rg) => (
        <div class="card-academic p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2 py-0.5 bg-navy-900 text-gold-400 font-code font-bold text-xs rounded">
                {rg.code}
              </span>
              <span class="text-[11px] text-slate-500 font-medium">
                {rg.members.length} Peneliti
              </span>
            </div>

            <h3 class="text-sm font-bold text-navy-900 leading-snug mb-2 font-editorial">
              {isEn ? rg.name : rg.name_id}
            </h3>

            <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed mb-4">
              {rg.focus}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100">
            <span class="text-[10px] text-slate-400 uppercase font-bold block mb-0.5">
              {isEn ? 'Lead Coordinator:' : 'Koordinator Klaster:'}
            </span>
            <span class="text-xs font-semibold text-navy-900 block truncate">
              {rg.coordinator}
            </span>
            <div class="mt-3">
              <a
                href={`${isEn ? '/en/research/groups/#' : '/riset/kelompok-riset/#'}${rg.id}`}
                class="text-xs font-bold text-gold-700 hover:text-navy-900 flex items-center transition-colors"
              >
                {isEn ? 'View Roadmap & Topics →' : 'Roadmap & Topik Skripsi →'}
              </a>
            </div>
          </div>
        </div>
      ))}

      {/* Featured CTA Card in the grid */}
      <div class="card-academic p-6 bg-navy-900 text-white border-navy-800 flex flex-col justify-between">
        <div>
          <span class="text-[10px] uppercase tracking-wider text-gold-400 font-bold block mb-2">
            {isEn ? 'Undergraduate Research' : 'Riset Mahasiswa & Skripsi'}
          </span>
          <h3 class="text-base font-bold text-white font-editorial mb-3">
            {isEn ? 'Open Thesis Topics & Mentorship' : 'Topik Skripsi Terbuka & Kolaborasi Riset'}
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            {isEn
              ? 'Students are actively involved in funded grants, Scopus publications, and international conference presentations guided by faculty mentors.'
              : 'Mahasiswa dibimbing langsung dalam payung penelitian dosen, publikasi jurnal bereputasi SINTA/Scopus, serta hilirisasi produk inovasi ke masyarakat.'}
          </p>
        </div>
        <div class="pt-4 border-t border-navy-800">
          <a
            href={isEn ? '/en/research/groups/#thesis-topics' : '/riset/kelompok-riset/#topik-skripsi'}
            class="w-full inline-flex items-center justify-center px-4 py-2 bg-gold-500 hover:bg-gold-600 text-white font-bold text-xs uppercase tracking-wider rounded transition-colors"
          >
            {isEn ? 'View Open Topics' : 'Lihat Daftar Topik'}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
