---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResearchGroupCard from '../../../components/research/ResearchGroupCard.astro';
import groups from '../../../data/research_groups.json';
---

<BaseLayout
  title="5 Kelompok Riset (Research Groups) — Program Studi Sistem Informasi"
  description="Profil 5 Kelompok Riset Dosen Sistem Informasi Universitas Darwan Ali: AIML-RG, SETK-RG, MHUI-RG, DSDSS-RG, dan EDUTECH-RG. Roadmap penelitian, publikasi internasional Scopus, dan topik skripsi mahasiswa."
  lang="id"
>
  {/* Header */}
  <section class="bg-navy-900 text-white border-b border-navy-800 py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-md bg-navy-950 border border-navy-800 text-xs font-semibold text-gold-300 mb-4">
          <span>Pusat Studi & Klaster Keilmuan</span>
          <span class="text-slate-600">·</span>
          <span>5 Kelompok Riset Kolaboratif</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-editorial tracking-tight text-white mb-4">
          Kelompok Studi Riset Dosen Sistem Informasi
        </h1>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Wadah kolaborasi riset strategis dosen dan mahasiswa yang mengintegrasikan rekayasa kecerdasan buatan, bio-sinyal EEG, tata kelola sistem enterprise, perancangan antarmuka human-centered, analitika data multikriteria, dan teknologi pendidikan.
        </p>
      </div>

      {/* Group Navigation Chips */}
      <div class="mt-8 pt-6 border-t border-navy-800/80 flex flex-wrap gap-2 text-xs">
        {groups.map((rg) => (
          <a
            href={`#${rg.id}`}
            class="px-3 py-1.5 rounded bg-navy-800 hover:bg-gold-500 hover:text-white text-slate-200 transition-colors font-semibold"
          >
            {rg.code}
          </a>
        ))}
        <a
          href="#topik-skripsi"
          class="px-3 py-1.5 rounded bg-gold-500 text-white font-bold hover:bg-gold-600 transition-colors"
        >
          ↓ Katalog Topik Skripsi Terbuka
        </a>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    
    {/* Detailed Section for Each Research Group */}
    {groups.map((rg, idx) => (
      <ResearchGroupCard rg={rg} idx={idx} lang="id" />
    ))}

    {/* Section 6: Open Thesis Topics */}
    <section id="topik-skripsi" class="scroll-mt-24 rounded-2xl p-6 sm:p-10 bg-navy-950 text-white border border-navy-800 shadow-xl">
      <div class="border-b border-navy-800 pb-4 mb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-gold-400 block">Kemitraan Mahasiswa</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white font-editorial">
          Katalog Topik Skripsi Terbuka bagi Mahasiswa
        </h2>
        <p class="text-xs sm:text-sm text-slate-200 mt-2 font-medium">
          Mahasiswa tingkat akhir diarahkan untuk mengambil topik skripsi yang selaras dengan payung penelitian dosen pembimbing agar memperoleh pendampingan metodologis yang kokoh dan berpeluang menghasilkan publikasi ilmiah bersama.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {groups.map((rg) => (
          <div class="bg-navy-900 border border-navy-800 rounded-xl p-5 sm:p-6 space-y-3 min-w-0 break-words">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3 border-b border-navy-800 pb-2">
              <span class="px-2 py-0.5 rounded bg-gold-500 text-white font-bold font-code text-xs">
                {rg.code}
              </span>
              <span class="text-xs text-slate-300 font-medium min-w-0 break-words">
                {rg.coordinator}
              </span>
            </div>

            <ul class="space-y-3 text-xs text-slate-200">
              {rg.thesis_topics.map((topic: string) => (
                <li class="flex items-start">
                  <span class="text-gold-400 mr-2 font-bold">›</span>
                  <span class="leading-relaxed">{topic}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-8 pt-6 border-t border-navy-800 text-center">
        <p class="text-xs text-slate-200 font-medium mb-4">
          Konsultasikan topik skripsi Anda langsung dengan Koordinator Kelompok Riset terkait atau ajukan melalui formulir pengajuan judul di Layanan Mahasiswa.
        </p>
        <a
          href="/mahasiswa/#skripsi"
          class="inline-flex items-center px-5 py-2.5 rounded bg-gold-500 hover:bg-gold-600 text-white font-bold text-xs uppercase tracking-wider transition-colors"
        >
          Lihat Panduan & SOP Skripsi OBE →
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
