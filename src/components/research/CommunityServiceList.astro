---
import programs from '../../data/community_service.json';
import civitas from '../../data/civitas.json';

interface Props { lang: 'id' | 'en' }
const { lang } = Astro.props;
const en = lang === 'en';

const L = en ? {
  eyebrow: 'Applied Research for Society',
  h1: 'Community Service (PkM)',
  lead: 'Verified community service programs by Information Systems faculty, grounded in the applied research of our research groups and delivered to communities across East Kotawaringin.',
  stats: ['Verified Programs', 'National Competitive BIMA Grants', 'Research Groups', 'Real Impact in Kotim'],
  filterLabel: 'Filter by scheme',
  filters: ['All', 'BIMA Grants', 'SINTA/Garuda Service Journals', 'Vocational Partnerships'],
  showing: 'Showing', of: 'of', programs: 'programs',
  partner: 'Community Partner / Location', team: 'Community Service Team', output: 'Summary & Tangible Output',
  student: 'Undergraduate Information Systems students', lead_tag: 'Lead',
  tangible_label: 'Tangible Output & Community Impact:',
  sinta: 'View on SINTA', garuda: 'View on Garuda', scholar: 'View on SINTA (Scholar)',
  groupHref: '/en/research/groups/', profile: (s: string) => `/en/faculty/${s}/`,
} : {
  eyebrow: 'Riset Terapan untuk Masyarakat',
  h1: 'Pengabdian kepada Masyarakat (PkM)',
  lead: 'Program PkM terverifikasi dosen Sistem Informasi yang bertumpu pada riset terapan kelompok riset dan menjangkau masyarakat di seluruh Kotawaringin Timur.',
  stats: ['Program Terverifikasi', 'Hibah Kompetitif Nasional BIMA', 'Kelompok Riset', 'Berdampak Nyata Kotim'],
  filterLabel: 'Filter skema',
  filters: ['Semua', 'Hibah BIMA', 'Jurnal Pengabdian SINTA/Garuda', 'Kemitraan Vokasi'],
  showing: 'Menampilkan', of: 'dari', programs: 'program',
  partner: 'Mitra Komunitas / Lokus Kegiatan', team: 'Tim Dosen Pengabdi', output: 'Ringkasan & Luaran Nyata',
  student: 'Mahasiswa S1 Sistem Informasi', lead_tag: 'Ketua',
  tangible_label: 'Luaran Nyata & Dampak Mitra:',
  sinta: 'Lihat di SINTA', garuda: 'Lihat di Garuda', scholar: 'Lihat di SINTA (Scholar)',
  groupHref: '/riset/kelompok-riset/', profile: (s: string) => `/civitas/dosen/${s}/`,
};

// Map faculty name to slug
const slugByName = new Map<string, string>(
  (civitas.faculty as { name: string; slug: string }[]).map((f) => [f.name, f.slug]),
);

const category = (p: any) =>
  /BIMA/i.test(p.scheme_id) ? 'bima'
  : /Kemitraan|Vokasi/i.test(p.scheme_id) ? 'kemitraan'
  : 'jurnal';

// MIT Visual Style palette: Cardinal red tint for BIMA, Slate for Journals, Navy for Partnerships
const badgeClass: Record<string, string> = {
  bima: 'bg-gold-50 text-gold-700 border border-gold-200/90 font-semibold',
  jurnal: 'bg-slate-100 text-slate-800 border border-slate-300 font-semibold',
  kemitraan: 'bg-navy-50 text-navy-900 border border-navy-200 font-semibold',
};

const sintaLabel = (url: string) =>
  /view=garuda/.test(url) ? L.garuda : /view=googlescholar/.test(url) ? L.scholar : L.sinta;

const items = (programs as any[]).map((p) => {
  const members = (p.team as string[]).map((raw) => {
    const isLead = /\(Ketua\)/.test(raw);
    const name = raw.replace(/\s*\(Ketua\)/, '').trim();
    return { name, isLead, slug: slugByName.get(name) };
  });
  return { p, cat: category(p), members };
});

const count = (c: string) => items.filter((i) => i.cat === c).length;
const groups = new Set(items.map((i) => i.p.group_code)).size;
const filterKeys = ['all', 'bima', 'jurnal', 'kemitraan'];
const statValues = [`${items.length}`, `${count('bima')}`, `${groups}`, '100%'];
---

<section class="bg-navy-950 text-white border-b border-navy-800 py-12 sm:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <span class="text-xs font-bold font-code uppercase tracking-wider text-gold-300 block mb-3">{L.eyebrow}</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-editorial tracking-tight text-white mb-4">{L.h1}</h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">{L.lead}</p>
    </div>
  </div>
</section>

<section class="bg-navy-900 border-b border-navy-800" aria-label="Statistik">
  <dl class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-5">
    {statValues.map((v, i) => (
      <div class="border-l-2 border-gold-400 pl-4">
        <dt class="sr-only">{L.stats[i]}</dt>
        <dd class="font-editorial text-3xl font-bold text-white tracking-tight">{v}</dd>
        <dd class="text-[11px] font-code uppercase tracking-wider text-slate-300 mt-1" aria-hidden="true">{L.stats[i]}</dd>
      </div>
    ))}
  </dl>
</section>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div role="group" aria-label={L.filterLabel} class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden" id="pkm-filters">
      {L.filters.map((label, i) => (
        <button
          type="button"
          data-filter={filterKeys[i]}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="pkm-filter shrink-0 px-3.5 py-1.5 rounded-md text-xs font-bold font-sans border border-slate-300 text-slate-700 bg-white hover:border-gold-600 hover:text-gold-700 transition-all aria-pressed:bg-navy-900 aria-pressed:text-white aria-pressed:border-navy-900 shadow-2xs"
        >{label}</button>
      ))}
    </div>
    <p class="text-xs font-code text-slate-600 shrink-0" aria-live="polite">
      {L.showing} <span id="pkm-visible" class="font-bold text-navy-950">{items.length}</span> {L.of} {items.length} {L.programs}
    </p>
  </div>

  <ul class="grid md:grid-cols-2 gap-6 items-stretch" id="pkm-grid">
    {items.map(({ p, cat, members }) => (
      <li data-category={cat} class="pkm-card flex">
        <article class="card-academic w-full p-6 sm:p-7 flex flex-col justify-between group hover:border-gold-500/80 transition-all shadow-sm" id={p.id}>
          <div>
            <!-- Header Top: Group Code & Year -->
            <div class="flex items-center justify-between gap-2 mb-2.5">
              <a href={`${L.groupHref}#${p.group_id}`} title={en ? p.group_name_en : p.group_name_id}
                 class="inline-flex items-center px-2.5 py-1 rounded text-[11px] font-bold font-code bg-navy-950 text-white hover:bg-gold-600 transition-colors whitespace-nowrap shadow-2xs">
                {p.group_code}
              </a>
              <span class="text-xs font-code font-bold text-slate-500 whitespace-nowrap">{p.year}</span>
            </div>

            <!-- Scheme Badge -->
            <div class="mb-3">
              <span class={`inline-block px-2.5 py-0.5 rounded text-[11px] ${badgeClass[cat]}`}>
                {en ? p.scheme_en : p.scheme_id}
              </span>
            </div>

            <!-- Program Title -->
            <h2 class="font-editorial text-lg sm:text-xl font-bold text-navy-900 leading-snug group-hover:text-gold-700 transition-colors">
              {en ? p.title_en : p.title_id}
            </h2>

            <!-- Partner / Location -->
            <div class="mt-4 pt-3 border-t border-slate-100">
              <h3 class="text-[11px] font-bold font-code uppercase tracking-wider text-slate-600">{L.partner}</h3>
              <p class="mt-1 text-sm text-slate-800 leading-relaxed font-medium">{p.partner}</p>
            </div>

            <!-- Team -->
            <div class="mt-3.5">
              <h3 class="text-[11px] font-bold font-code uppercase tracking-wider text-slate-600">{L.team}</h3>
              <ul class="mt-1 text-sm text-slate-800 space-y-1">
                {members.map((m) => (
                  <li class="flex items-center flex-wrap gap-1">
                    {m.slug
                      ? <a href={L.profile(m.slug)} class="font-semibold text-navy-900 underline underline-offset-4 decoration-slate-300 hover:text-gold-700 hover:decoration-gold-600 transition-colors">{m.name}</a>
                      : <span class="text-slate-800 font-medium">{m.name === 'Mahasiswa S1 Sistem Informasi' ? L.student : m.name}</span>}
                    {m.isLead && <span class="px-1.5 py-0.2 rounded text-[10px] font-code font-bold bg-gold-100 text-gold-700 border border-gold-200">({L.lead_tag})</span>}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Summary & Output Box -->
            <div class="mt-4">
              <h3 class="text-[11px] font-bold font-code uppercase tracking-wider text-slate-600">{L.output}</h3>
              <p class="mt-1 text-sm text-slate-700 leading-relaxed">{en ? p.summary_en : p.summary_id}</p>
              <div class="mt-2.5 p-3 rounded-md bg-canvas-subtle border-l-4 border-gold-600 text-xs sm:text-sm text-slate-900 font-medium leading-relaxed">
                <span class="text-[10px] font-bold font-code uppercase tracking-wider text-gold-700 block mb-0.5">{L.tangible_label}</span>
                {en ? p.output_en : p.output_id}
              </div>
            </div>
          </div>

          <!-- Card Footer: Always anchored at bottom -->
          <div class="mt-6 pt-3.5 border-t border-slate-100 flex items-center justify-between text-xs">
            {p.sinta_url ? (
              <a href={p.sinta_url} target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-1.5 font-bold font-code text-gold-700 hover:text-gold-900 underline underline-offset-4 decoration-gold-300 hover:decoration-gold-600 transition-all">
                <span>{sintaLabel(p.sinta_url)}</span>
                <span aria-hidden="true" class="text-sm font-sans">↗</span>
              </a>
            ) : <span />}
            <span class="text-[10.5px] font-code text-slate-500 uppercase tracking-wider truncate max-w-[220px]" title={p.funding_source}>
              {p.funding_source ? (p.funding_source.length > 25 ? p.funding_source.slice(0, 23) + '…' : p.funding_source) : ''}
            </span>
          </div>
        </article>
      </li>
    ))}
  </ul>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.pkm-filter');
  const cards = document.querySelectorAll<HTMLElement>('.pkm-card');
  const counter = document.getElementById('pkm-visible');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let n = 0;
      cards.forEach((c) => {
        const show = f === 'all' || c.dataset.category === f;
        c.hidden = !show;
        if (show) n++;
      });
      if (counter) counter.textContent = String(n);
    });
  });
</script>
