---
interface Props {
  currentLang?: 'id' | 'en';
}

const { currentLang = 'id' } = Astro.props;
import navigation from '../../data/navigation.json';
import LanguageToggle from './LanguageToggle.astro';

const currentPath = Astro.url.pathname;
const menu = currentLang === 'en' ? navigation.menu_en : navigation.menu_id;
const isEn = currentLang === 'en';

const spmbPortal = navigation.portals.find(p => p.featured) || navigation.portals[0];
---

<header class="sticky top-0 z-50 bg-navy-900 border-b border-navy-800 text-white shadow-md">
  {/* Institutional Top Bar */}
  <div class="bg-navy-950 border-b border-navy-800/80 text-slate-300 text-xs py-1.5 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center space-x-3">
        <span class="inline-flex items-center text-gold-400 font-medium">
          <svg class="w-3.5 h-3.5 mr-1" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a10.927 10.927 0 00-1.74 3.793A1 1 0 004.5 13h11a1 1 0 00.99-1.156 10.927 10.927 0 00-1.74-3.793l2.644-1.131a1 1 0 000-1.84l-7-3zM10 4.223L15.313 6.5 10 8.777 4.687 6.5 10 4.223zM5.5 11a8.956 8.956 0 011.536-3.328l2.67 1.144a1 1 0 00.788 0l2.67-1.144A8.956 8.956 0 0114.5 11h-9z" />
          </svg>
          {isEn ? 'Accreditation: Baik Sekali' : 'Akreditasi: Baik Sekali'}
        </span>
        <span class="text-slate-600 hidden sm:inline">|</span>
        <span class="hidden sm:inline text-slate-400">
          Fakultas Ilmu Komputer · Universitas Darwan Ali
        </span>
      </div>

      <div class="flex items-center space-x-4">
        {/* Institutional Portals Quick Links */}
        <div class="hidden md:flex items-center space-x-3 text-slate-300">
          <a href="https://siak.unda.ac.id/" target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors">SIAKAD</a>
          <span class="text-slate-700">·</span>
          <a href="https://edlink.id/" target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors">Edlink</a>
          <span class="text-slate-700">·</span>
          <a href="https://cloud.unda.ac.id/moodle" target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors">Moodle</a>
          <span class="text-slate-700">·</span>
          <a href="https://esign-fikom.unda.ac.id/" target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors">eSign</a>
        </div>

        <LanguageToggle currentLang={currentLang} currentPath={currentPath} />
      </div>
    </div>
  </div>

  {/* Main Navbar */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      {/* Brand Logo & Name */}
      <a href={isEn ? '/en/' : '/'} class="flex items-center space-x-3 group text-left rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2 focus-visible:ring-offset-navy-900">
        <div class="flex items-center shrink-0 bg-white px-2 py-1 rounded-md shadow-sm border border-gold-500/30">
          <img src="/images/logo/logo-unda.png" alt="Logo Universitas Darwan Ali" width="40" height="40" class="h-9 sm:h-10 w-auto object-contain" />
          <span class="mx-2.5 h-8 w-px bg-slate-300" aria-hidden="true"></span>
          <img src="/images/logo/logo-sisfo.png" alt={isEn ? 'Logo of the Information Systems Program' : 'Logo S1 Sistem Informasi'} width="40" height="40" class="h-9 sm:h-10 w-auto object-contain" />
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-base sm:text-lg text-white tracking-tight leading-tight group-hover:text-gold-300 transition-colors">
            {isEn ? 'Information Systems' : 'S1 Sistem Informasi'}
          </span>
          <span class="hidden md:block text-xs text-slate-400 font-medium">
            Fakultas Ilmu Komputer · Universitas Darwan Ali
          </span>
        </div>
      </a>

      {/* Desktop Navigation Links */}
      <nav class="hidden lg:flex items-center space-x-1" aria-label="Main Navigation">
        {menu.map((item) => (
          <div class="relative group">
            <a
              href={item.href}
              class={`px-3 py-2 rounded-md text-sm font-medium transition-colors inline-flex items-center ${
                currentPath === item.href || (item.href !== '/' && item.href !== '/en/' && currentPath.startsWith(item.href))
                  ? 'text-gold-400 font-semibold'
                  : 'text-slate-200 hover:text-white hover:bg-navy-800'
              }`}
            >
              {item.label}
              {item.sub && (
                <svg class="w-3.5 h-3.5 ml-1 text-slate-400 group-hover:text-white transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>

            {/* Dropdown Menu */}
            {item.sub && (
              <div class="absolute left-0 mt-1 w-56 rounded-md shadow-lg bg-navy-950 border border-navy-800 py-2 hidden group-hover:block transition-all duration-200 z-50">
                {item.sub.map((subItem) => (
                  <a
                    href={subItem.href}
                    class="block px-4 py-2 text-xs text-slate-300 hover:bg-navy-800 hover:text-gold-400 transition-colors"
                  >
                    {subItem.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </nav>

      {/* Action CTA & Search Button */}
      <div class="hidden lg:flex items-center space-x-3">
        {/* Search Modal Trigger Button */}
        <button
          type="button"
          id="btn-open-search"
          class="p-2 text-slate-300 hover:text-gold-400 hover:bg-navy-800 rounded-md transition-colors"
          aria-label="Cari Dokumen"
          title="Pencarian Pagefind"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        {/* Featured SPMB Admission CTA */}
        <a
          href={spmbPortal.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-4 py-2 rounded-md bg-gold-500 hover:bg-gold-600 text-navy-950 font-bold text-xs uppercase tracking-wider shadow-sm transition-all duration-150 transform hover:-translate-y-0.5"
        >
          {isEn ? 'Apply Now' : 'Daftar SPMB'}
          <svg class="w-3.5 h-3.5 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      {/* Mobile Menu Hamburger Button */}
      <div class="flex items-center lg:hidden space-x-2">
        <button
          type="button"
          id="btn-open-search-mobile"
          class="p-2 text-slate-300 hover:text-white"
          aria-label="Cari Dokumen"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <button
          type="button"
          id="btn-mobile-menu"
          class="p-2 rounded-md text-slate-300 hover:text-white hover:bg-navy-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 touch-target"
          aria-expanded="false"
          aria-label="Buka Menu Navigasi"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Mobile Navigation Drawer */}
  <div id="mobile-drawer" class="fixed inset-0 z-50 transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden hidden">
    {/* Backdrop */}
    <div id="mobile-backdrop" class="fixed inset-0 bg-navy-950/80 backdrop-blur-sm"></div>

    {/* Panel */}
    <div class="fixed inset-y-0 right-0 max-w-xs w-full bg-navy-900 border-l border-navy-800 p-6 shadow-2xl flex flex-col justify-between overflow-y-auto">
      <div>
        <div class="flex items-center justify-between pb-4 border-b border-navy-800">
          <div class="flex items-center min-w-0">
            <div class="flex items-center shrink-0 bg-white px-2 py-1 rounded-md shadow-sm border border-gold-500/30">
              <img src="/images/logo/logo-unda.png" alt="Logo Universitas Darwan Ali" width="40" height="40" loading="lazy" class="h-9 w-auto object-contain" />
              <span class="mx-2.5 h-8 w-px bg-slate-300" aria-hidden="true"></span>
              <img src="/images/logo/logo-sisfo.png" alt={isEn ? 'Logo of the Information Systems Program' : 'Logo S1 Sistem Informasi'} width="40" height="40" loading="lazy" class="h-9 w-auto object-contain" />
            </div>
            <span class="ml-3 font-bold text-white text-sm leading-tight">
              {isEn ? 'Information Systems' : 'S1 Sistem Informasi'}
            </span>
          </div>
          <button
            type="button"
            id="btn-close-mobile"
            class="p-2 rounded-md text-slate-400 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 touch-target"
            aria-label="Tutup Menu"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        {/* Mobile Language Switcher */}
        <div class="py-4 border-b border-navy-800/80 flex items-center justify-between">
          <span class="text-xs text-slate-400 font-medium">Bahasa / Language</span>
          <LanguageToggle currentLang={currentLang} currentPath={currentPath} />
        </div>

        {/* Mobile Nav Links */}
        <nav class="mt-4 space-y-1">
          {menu.map((item) => (
            <div>
              <a
                href={item.href}
                class="block px-3 py-2.5 rounded-md text-sm font-medium text-slate-200 hover:bg-navy-800 hover:text-gold-400 transition-colors"
              >
                {item.label}
              </a>
              {item.sub && (
                <div class="pl-4 space-y-1 border-l border-navy-800 ml-3 my-1">
                  {item.sub.map((sub) => (
                    <a
                      href={sub.href}
                      class="block px-3 py-1.5 text-xs text-slate-400 hover:text-gold-300 transition-colors"
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </nav>
      </div>

      <div class="pt-6 border-t border-navy-800 mt-6 space-y-3">
        <a
          href={spmbPortal.url}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center px-4 py-3 rounded-md bg-gold-500 hover:bg-gold-600 text-navy-950 font-bold text-xs uppercase tracking-wider shadow-sm transition-colors"
        >
          {isEn ? 'Apply for Admission' : 'Pendaftaran SPMB Online'}
        </a>
        <div class="text-center">
          <span class="text-xs text-slate-400">Fakultas Ilmu Komputer · Universitas Darwan Ali</span>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile drawer logic
  const btnMenu = document.getElementById('btn-mobile-menu');
  const btnClose = document.getElementById('btn-close-mobile');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('mobile-backdrop');

  function openMenu() {
    if (!drawer) return;
    drawer.classList.remove('hidden');
    setTimeout(() => {
      drawer.classList.remove('translate-x-full');
    }, 10);
  }

  function closeMenu() {
    if (!drawer) return;
    drawer.classList.add('translate-x-full');
    setTimeout(() => {
      drawer.classList.add('hidden');
    }, 300);
  }

  btnMenu?.addEventListener('click', openMenu);
  btnClose?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);
</script>
