---
interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;
const isEn = lang === 'en';
const certUrl = '/dokumen/akreditasi/Sertifikat-Akreditasi-LAM-INFOKOM-SI.pdf';
const spmiUrl = '/dokumen/akreditasi/22-Sept-2023-SPMI-LAM-INFOKOM.pptx';
---

<section class="py-16 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-8 space-y-4">
        <span class="text-xs font-bold uppercase tracking-wider text-gold-600 block">
          {isEn ? 'Institutional Quality Assurance' : 'Penjaminan Mutu & Akreditasi'}
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 tracking-tight font-editorial">
          {isEn ? 'Officially Accredited "Baik Sekali"' : 'Program Studi Terakreditasi "Baik Sekali"'}
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-2xl">
          {isEn
            ? 'The Information Systems Undergraduate Program at Universitas Darwan Ali is committed to continuous quality improvement, audited by national accreditation bodies, and aligned with international Outcome-Based Education standards.'
            : 'Program Studi S1 Sistem Informasi Fakultas Ilmu Komputer Universitas Darwan Ali senantiasa menjaga standar penjaminan mutu pendidikan tinggi nasional (SPMI/SPME) untuk memastikan kelayakan fasilitas, kualifikasi dosen, ketercapaian CPL, dan serapan lulusan di dunia kerja.'}
        </p>

        <div class="pt-2 flex flex-wrap gap-4 text-xs font-medium text-slate-700">
          <div class="flex items-center space-x-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>{isEn ? 'National Accreditation Agency (BAN-PT)' : 'Sertifikasi BAN-PT'}</span>
          </div>
          <div class="flex items-center space-x-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>{isEn ? 'LAM INFOKOM Criteria OBE' : 'Standar Akreditasi LAM INFOKOM'}</span>
          </div>
          <div class="flex items-center space-x-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>{isEn ? 'ISO-Compliant Internal Quality Audit' : 'Audit Mutu Internal (AMI) Terjadwal'}</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-4">
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 text-center space-y-3">
          <div class="w-16 h-16 mx-auto rounded-full bg-gold-50 border-2 border-gold-400 flex items-center justify-center text-gold-700">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <div>
            <span class="text-xs uppercase tracking-wider font-bold text-slate-500 block">Status Akreditasi</span>
            <span class="text-xl font-bold text-navy-900 font-editorial block">Baik Sekali</span>
          </div>
          <div class="flex items-center justify-center gap-3">
            <img src="/images/logo/logo-dikti.png" alt={isEn ? 'Ministry of Higher Education, Science, and Technology logo' : 'Logo Kementerian Pendidikan Tinggi, Sains, dan Teknologi'} class="h-10 w-auto object-contain bg-white p-1 rounded" loading="lazy" />
            <p class="text-xs text-slate-500 text-left">
              {isEn ? 'Higher Education Quality Directorate' : 'Kementerian Pendidikan Tinggi, Sains, dan Teknologi'}
            </p>
          </div>
          <div class="flex flex-col gap-2 pt-1">
            <a href={certUrl} download class="inline-flex items-center justify-center px-4 py-2.5 rounded bg-navy-900 hover:bg-navy-700 text-white text-xs font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-600 focus-visible:ring-offset-2">
              <svg class="w-4 h-4 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              {isEn ? 'Download Accreditation Certificate (PDF)' : 'Unduh Sertifikat Akreditasi (PDF)'}
            </a>
            <a href={spmiUrl} download class="inline-flex items-center justify-center px-4 py-2.5 rounded border border-navy-900 text-navy-900 hover:bg-navy-900 hover:text-white text-xs font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-600 focus-visible:ring-offset-2">
              <svg class="w-4 h-4 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              {isEn ? 'Download SPMI Material (PPTX)' : 'Unduh Materi SPMI (PPTX)'}
            </a>
          </div>
          <a
            href={isEn ? '/en/about/#accreditation' : '/profil/#akreditasi'}
            class="inline-block text-xs font-bold text-navy-900 hover:text-gold-700 underline pt-1"
          >
            {isEn ? 'View Accreditation Details →' : 'Lihat Detail Akreditasi →'}
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
