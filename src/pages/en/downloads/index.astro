---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const docs = [
  {
    category: 'Official Accreditation Documents',
    items: [
      {
        title: 'LAM INFOKOM Accreditation Certificate — Information Systems',
        desc: 'Official accreditation certificate of the Undergraduate Information Systems Program issued by LAM INFOKOM.',
        size: 'PDF · 238 KB',
        link: '/dokumen/akreditasi/Sertifikat-Akreditasi-LAM-INFOKOM-SI.pdf'
      },
      {
        title: 'LAM INFOKOM Internal Quality Assurance (SPMI) Material, 22 Sept 2023',
        desc: 'Presentation material on the internal quality assurance system (SPMI) in the LAM INFOKOM accreditation framework.',
        size: 'PPTX · 9.0 MB',
        link: '/dokumen/akreditasi/22-Sept-2023-SPMI-LAM-INFOKOM.pptx'
      }
    ]
  },
  {
    category: 'Capstone Thesis & Research Guidelines',
    items: [
      {
        title: 'OBE Undergraduate Thesis Standards & Manual (SIFC8B01)',
        desc: 'Comprehensive guide covering chapters 1–5, research methodology, IEEE citation standards, and examiner evaluation rubrics.',
        size: 'PDF · 1.4 MB',
        link: '#'
      },
      {
        title: 'LaTeX & Word Thesis Templates',
        desc: 'Standardized templates including title pages, approval sheets, bilingual abstracts, and chapter layouts.',
        size: 'ZIP / DOCX · 850 KB',
        link: '#'
      },
      {
        title: 'Thesis Proposal & Advisor Selection Form',
        desc: 'Official submission form matching student topics with the 5 Faculty Research Groups.',
        size: 'PDF · 210 KB',
        link: '#'
      }
    ]
  },
  {
    category: 'Internships & MBKM Program Guidelines',
    items: [
      {
        title: 'Information Systems Field Internship (KP) Manual',
        desc: 'SOP for corporate observational permits, weekly activity logbooks, professional ethics, and final reporting.',
        size: 'PDF · 920 KB',
        link: '#'
      },
      {
        title: '20-Credit MBKM Conversion Protocol',
        desc: 'Rubrics mapping industry internships and independent study outcomes into semesters 6 & 7 coursework.',
        size: 'PDF · 640 KB',
        link: '#'
      }
    ]
  },
  {
    category: 'Administrative & Clearance Forms',
    items: [
      {
        title: 'Institutional Research & Survey Permit Letter',
        desc: 'Formal university introductory letter requesting data access from partner corporations and government agencies.',
        size: 'DOCX · 180 KB',
        link: '#'
      },
      {
        title: 'Library & Computing Laboratory Clearance Form',
        desc: 'Mandatory clearance prerequisite for graduation certification and degree conferral.',
        size: 'PDF · 140 KB',
        link: '#'
      }
    ]
  }
];
---

<BaseLayout
  title="Downloads & Academic Documents — Information Systems Program"
  description="Official document repository for Information Systems at Universitas Darwan Ali: thesis templates, internship manuals, academic forms, and MBKM guides."
  lang="en"
>
  <section class="bg-navy-900 text-white border-b border-navy-800 py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-navy-950 border border-gold-500/40 text-xs font-semibold text-gold-300 mb-4">
          <span>Official Document Archive</span>
          <span class="text-slate-600">·</span>
          <span>Verified Institutional Formats</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-editorial tracking-tight text-white mb-4">
          Downloads & Academic Documents
        </h1>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Comprehensive inventory of academic manuals, manuscript writing guidelines, standardized Word and LaTeX templates, and administrative forms for students and faculty.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    
    {docs.map((grp) => (
      <section class="card-academic p-6 sm:p-8 border-slate-200">
        <h2 class="text-lg sm:text-xl font-bold text-navy-900 font-editorial border-b border-slate-200 pb-3 mb-6">
          {grp.category}
        </h2>

        <div class="space-y-4">
          {grp.items.map((doc) => (
            <div class="flex flex-col sm:flex-row sm:items-center justify-between p-4 rounded-lg bg-slate-50 border border-slate-200 hover:border-gold-400 transition-colors gap-4">
              <div class="space-y-1">
                <h3 class="text-sm font-bold text-navy-900 leading-snug">
                  {doc.title}
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  {doc.desc}
                </p>
                <span class="inline-block text-[10px] font-code text-slate-500">
                  {doc.size}
                </span>
              </div>

              <div class="sm:flex-shrink-0">
                <a
                  href={doc.link}
                  download={doc.link !== '#' ? '' : undefined}
                  class="inline-flex items-center justify-center px-4 py-2 rounded bg-navy-900 hover:bg-gold-500 text-white hover:text-white font-semibold text-xs transition-colors whitespace-nowrap shadow-xs"
                >
                  <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  Download File
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <div class="bg-navy-950 text-white rounded-lg p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1">
        <h4 class="text-base font-bold font-editorial text-gold-400">
          Looking for Course Syllabi (RPS)?
        </h4>
        <p class="text-xs text-slate-300">
          All 83 official syllabus PDF files are organized in our dedicated repository with instant search and filtering.
        </p>
      </div>
      <a
        href="/en/academics/rps/"
        class="inline-flex items-center px-5 py-2.5 rounded bg-gold-500 hover:bg-gold-600 text-white font-bold text-xs uppercase tracking-wider transition-colors whitespace-nowrap"
      >
        Open Syllabus Repository →
      </a>
    </div>

  </div>
</BaseLayout>
