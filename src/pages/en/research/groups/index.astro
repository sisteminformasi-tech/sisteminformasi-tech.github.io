---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ResearchGroupCard from '../../../../components/research/ResearchGroupCard.astro';
import groups from '../../../../data/research_groups.json';
---

<BaseLayout
  title="5 Research Groups — Information Systems Program"
  description="Profiles of 5 Faculty Research Groups in Information Systems at Universitas Darwan Ali: AIML-RG, SETK-RG, MHUI-RG, DSDSS-RG, and EDUTECH-RG. Roadmaps, Scopus publications, and open thesis topics."
  lang="en"
>
  {/* Header */}
  <section class="bg-navy-900 text-white border-b border-navy-800 py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-navy-950 border border-gold-500/40 text-xs font-semibold text-gold-300 mb-4">
          <span>Scholarly Research Clusters</span>
          <span class="text-slate-600">·</span>
          <span>5 Interdisciplinary Research Groups</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-editorial tracking-tight text-white mb-4">
          Information Systems Faculty Research Groups
        </h1>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Strategic research clusters integrating Artificial Intelligence, EEG Bio-signal processing, Enterprise Architecture, Human-Centered UI/UX, Multi-Criteria Decision Support, and Digital Pedagogy to address regional and global industrial challenges.
        </p>
      </div>

      <div class="mt-8 pt-6 border-t border-navy-800/80 flex flex-wrap gap-2 text-xs">
        {groups.map((rg) => (
          <a
            href={`#${rg.id}`}
            class="px-3 py-1.5 rounded bg-navy-800 hover:bg-gold-500 hover:text-white text-slate-200 transition-colors font-semibold"
          >
            {rg.code}
          </a>
        ))}
        <a
          href="#thesis-topics"
          class="px-3 py-1.5 rounded bg-gold-500 text-white font-bold hover:bg-gold-600 transition-colors"
        >
          ↓ Open Undergraduate Thesis Topics
        </a>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    
    {groups.map((rg, idx) => (
      <ResearchGroupCard rg={rg} idx={idx} lang="en" />
    ))}

    {/* Open Thesis Topics (EN) */}
    <section id="thesis-topics" class="scroll-mt-24 rounded-2xl p-6 sm:p-10 bg-[#071324] text-white border border-navy-800 shadow-xl">
      <div class="border-b border-navy-800 pb-4 mb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-gold-400 block">Undergraduate Research</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white font-editorial">
          Open Undergraduate Thesis Topics
        </h2>
        <p class="text-xs sm:text-sm text-slate-200 mt-2 font-medium">
          Final-year students are invited to embark on thesis topics aligned with our faculty research grants to ensure rigorous methodological supervision and co-authorship in scholarly venues.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {groups.map((rg) => (
          <div class="bg-navy-900 border border-navy-800 rounded-xl p-5 sm:p-6 space-y-3 min-w-0 break-words">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3 border-b border-navy-800 pb-2">
              <span class="px-2 py-0.5 rounded bg-gold-500 text-white font-bold font-code text-xs">
                {rg.code}
              </span>
              <span class="text-xs text-slate-300 font-medium min-w-0 break-words">
                {rg.coordinator}
              </span>
            </div>

            <ul class="space-y-3 text-xs text-slate-200">
              {rg.thesis_topics.map((topic: string) => (
                <li class="flex items-start">
                  <span class="text-gold-400 mr-2 font-bold">›</span>
                  <span class="leading-relaxed">{topic}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-8 pt-6 border-t border-navy-800 text-center">
        <p class="text-xs text-slate-200 font-medium mb-4">
          Consult your thesis proposal with the respective group coordinator or consult the Capstone Guidelines.
        </p>
        <a
          href="/en/students/#thesis"
          class="inline-flex items-center px-5 py-2.5 rounded bg-gold-500 hover:bg-gold-600 text-white font-bold text-xs uppercase tracking-wider transition-colors"
        >
          View Thesis SOP & Guidelines →
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
