---
import { splitFocus, initials, isCoordinatorEntry, cleanMember } from '../../lib/research';

interface Props {
  rg: any;
  idx: number;
  lang: 'id' | 'en';
}
const { rg, idx, lang } = Astro.props;
const t = lang === 'id'
  ? {
      cluster: 'Klaster Riset',
      coordinator: 'Koordinator',
      coordinatorLabel: 'Koordinator Klaster',
      focus: 'Fokus Inti & Lingkup Riset',
      team: 'Susunan Tim Peneliti',
      assistants: 'Asisten Peneliti',
      roadmap: 'Roadmap Penelitian Strategis',
      pubs: 'Publikasi Unggulan',
      pub: 'Publikasi',
      title: rg.name_id,
      subtitle: rg.name,
    }
  : {
      cluster: 'Research Cluster',
      coordinator: 'Coordinator',
      coordinatorLabel: 'Coordinator',
      focus: 'Core Focus & Research Scope',
      team: 'Research Team Roster',
      assistants: 'Research Assistants',
      roadmap: 'Strategic Research Roadmap',
      pubs: 'Flagship Publications',
      pub: 'Publication',
      title: rg.name,
      subtitle: rg.name_id,
    };
const focusChips = splitFocus(rg.focus);
const members = rg.members.map((m: string) => ({
  name: cleanMember(m),
  lead: isCoordinatorEntry(m),
}));
members.sort((a: any, b: any) => Number(b.lead) - Number(a.lead));
const h3 = 'text-xs font-bold uppercase tracking-wider text-navy-900 border-l-2 border-gold-500 pl-2';
---

<section id={rg.id} class="scroll-mt-24 card-academic p-6 sm:p-10 border-slate-200">
  <header class="flex flex-col md:flex-row md:items-start justify-between gap-5 border-b border-slate-200 pb-6 mb-6">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="px-2.5 py-1 rounded-md bg-navy-900 text-gold-400 font-code font-bold text-xs border border-navy-800">{rg.code}</span>
        <span class="text-xs font-bold uppercase tracking-wider text-gold-700">{t.cluster} #{idx + 1}</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 font-editorial">{t.title}</h2>
      <span class="text-xs text-slate-500 font-medium italic block mt-1">{t.subtitle}</span>
    </div>

    <div class="shrink-0 md:min-w-[15rem] rounded-lg bg-white border border-slate-200/80 shadow-2xs p-3.5 flex items-center space-x-3">
      <span class="w-10 h-10 rounded-full bg-navy-900 text-gold-400 flex items-center justify-center text-xs font-bold font-code" aria-hidden="true">{initials(rg.coordinator)}</span>
      <div class="min-w-0">
        <span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 block">{t.coordinatorLabel}</span>
        <span class="text-xs font-bold text-navy-900 block leading-snug">{rg.coordinator}</span>
        <span class="text-[10px] text-slate-500 font-code">NUPTK: {rg.coordinator_nuptk}</span>
      </div>
    </div>
  </header>

  <div class="mb-8">
    <h3 class={`${h3} mb-3`}>{t.focus}</h3>
    <ul class="flex flex-wrap gap-2">
      {focusChips.map((chip: string) => (
        <li class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-[#FAF9F6] text-navy-950 border border-slate-200/80 shadow-2xs">
          <span class="w-1.5 h-1.5 rounded-full bg-gold-500 mr-2 shrink-0"></span>
          {chip}
        </li>
      ))}
    </ul>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-5 space-y-4">
      <h3 class={h3}>{t.team}</h3>
      <ul class="space-y-2">
        {members.map((m: any) => (
          m.lead ? (
            <li class="flex items-center justify-between gap-3 p-3 rounded-lg bg-navy-950 text-white border border-navy-800 shadow-2xs text-xs">
              <span class="flex items-center min-w-0">
                <span class="w-7 h-7 shrink-0 rounded-full bg-navy-800 text-gold-400 flex items-center justify-center text-[10px] font-bold font-code mr-3" aria-hidden="true">{initials(m.name)}</span>
                <span class="font-semibold leading-snug">{m.name}</span>
              </span>
              <span class="shrink-0 px-2 py-0.5 rounded bg-gold-500 text-white text-[10px] font-bold uppercase tracking-wider">{t.coordinator}</span>
            </li>
          ) : (
            <li class="flex items-center p-3 rounded-lg bg-slate-50/70 border border-slate-200/80 text-slate-800 text-xs">
              <span class="w-7 h-7 shrink-0 rounded-full bg-white border border-slate-200 text-navy-900 flex items-center justify-center text-[10px] font-bold font-code mr-3" aria-hidden="true">{initials(m.name)}</span>
              <span class="leading-snug">{m.name}</span>
            </li>
          )
        ))}
      </ul>

      {rg.assistants && rg.assistants.length > 0 && (
        <div class="pt-2">
          <span class="text-[11px] font-bold text-slate-600 block mb-2 uppercase tracking-wider">{t.assistants}</span>
          <ul class="flex flex-wrap gap-2">
            {rg.assistants.map((ast: string) => (
              <li class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-white text-slate-700 border border-slate-200/80 shadow-2xs">{ast}</li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="lg:col-span-7 space-y-4">
      <h3 class={h3}>{t.roadmap}</h3>
      <ol class="space-y-2.5">
        {rg.roadmap.map((step: string, i: number) => (
          <li class="p-3.5 rounded-lg bg-slate-50/70 border border-slate-200/80 flex items-start space-x-3 text-xs text-slate-700">
            <span class="font-code font-bold text-gold-700 bg-gold-100/60 px-1.5 py-0.5 rounded border border-gold-200 shrink-0">{String(i + 1).padStart(2, '0')}</span>
            <span class="leading-relaxed">{step}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  {rg.flagship_publications && rg.flagship_publications.length > 0 && (
    <div class="mt-8 pt-6 border-t border-slate-100">
      <h3 class={`${h3} mb-3`}>{t.pubs}</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        {rg.flagship_publications.map((pub: string, i: number) => (
          <article class="p-4 bg-white rounded-lg border border-slate-200 hover:border-gold-500 transition-colors flex flex-col gap-2">
            <span class="self-start px-2 py-0.5 rounded bg-navy-900 text-gold-400 font-code font-bold text-[10px] uppercase tracking-wider">{t.pub} #{i + 1}</span>
            <p class="text-xs text-slate-800 leading-relaxed">{pub}</p>
          </article>
        ))}
      </div>
    </div>
  )}
</section>
