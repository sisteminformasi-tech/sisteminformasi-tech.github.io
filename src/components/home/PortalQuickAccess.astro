---
interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;
import navigation from '../../data/navigation.json';
const isEn = lang === 'en';
---

<section class="py-12 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-gold-600 block mb-1">
          {isEn ? 'Campus Integrated Ecosystem' : 'Ekosistem Layanan Digital'}
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 tracking-tight font-editorial">
          {isEn ? 'Institutional Portals & Services' : 'Akses Cepat Portal Layanan Resmi'}
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-slate-500 max-w-md">
        {isEn 
          ? 'Single-point access for student registration, learning management, exam platforms, and electronic administration.'
          : 'Pintu gerbang tunggal untuk pendaftaran mahasiswa, sistem informasi akademik, platform kelas online, dan tanda tangan digital.'}
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      {navigation.portals.map((portal) => (
        <a
          href={portal.url}
          target="_blank"
          rel="noopener noreferrer"
          class={`flex flex-col justify-between p-4 rounded-lg border transition-all duration-200 group hover:-translate-y-1 ${
            portal.featured
              ? 'bg-navy-900 border-gold-500 text-white shadow-md'
              : 'bg-slate-50 hover:bg-white border-slate-200 hover:border-gold-400 text-navy-950 shadow-sm'
          }`}
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded ${
                portal.featured ? 'bg-gold-500 text-navy-950' : 'bg-slate-200 text-slate-700'
              }`}>
                {portal.badge}
              </span>
              <svg class={`w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 ${
                portal.featured ? 'text-gold-400' : 'text-slate-400 group-hover:text-gold-600'
              }`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
            <h3 class={`text-xs sm:text-sm font-bold leading-snug ${
              portal.featured ? 'text-white' : 'text-navy-900 group-hover:text-gold-700'
            }`}>
              {portal.name}
            </h3>
          </div>
          <div class={`text-[10px] mt-4 pt-2 border-t font-code ${
            portal.featured ? 'border-navy-800 text-slate-400' : 'border-slate-200 text-slate-500'
          }`}>
            Akses Langsung ↗
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
