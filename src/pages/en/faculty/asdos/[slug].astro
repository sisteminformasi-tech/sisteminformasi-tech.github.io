---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import civitas from '../../../../data/civitas.json';

export function getStaticPaths() {
  return civitas.assistants.map((asdos) => ({
    params: { slug: asdos.slug },
    props: { asdos },
  }));
}

const { asdos } = Astro.props;
---

<BaseLayout
  title={`${asdos.name} — Teaching Assistant Profile`}
  description={`Academic profile of ${asdos.name}, Teaching Assistant in Information Systems at Universitas Darwan Ali.`}
  lang="en"
>
  {/* Header */}
  <section class="bg-navy-900 text-white border-b border-navy-800 py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center space-x-2 text-xs text-slate-400 mb-6" aria-label="Breadcrumb">
        <a href="/en/" class="hover:text-gold-400">Home</a>
        <span>›</span>
        <a href="/en/faculty/" class="hover:text-gold-400">Faculty & Staff</a>
        <span>›</span>
        <span class="text-slate-200">{asdos.name}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-3 flex justify-center lg:justify-start">
          <div class="w-32 h-32 rounded-full bg-slate-800 border-4 border-gold-400 flex items-center justify-center text-white font-editorial font-bold text-3xl shadow-xl">
            {asdos.name.charAt(0)}
          </div>
        </div>

        <div class="lg:col-span-9 space-y-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-1 bg-gold-500 text-white font-bold text-xs uppercase tracking-wider rounded">
              Teaching Assistant
            </span>
            <span class="px-2.5 py-1 bg-navy-950 text-slate-300 font-code text-xs rounded border border-navy-800">
              Laboratory & Academic Support
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-bold font-editorial text-white tracking-tight">
            {asdos.name}
          </h1>

          <p class="text-sm sm:text-base text-slate-300 font-medium">
            {asdos.position || 'Teaching Assistant in Information Systems'} — Faculty of Computer Science, Universitas Darwan Ali
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-3xl mx-auto space-y-8">
      
      {/* Role and Responsibilities */}
      <div class="card-academic p-6 sm:p-8">
        <h2 class="text-lg font-bold text-navy-900 font-editorial border-b border-slate-200 pb-3 mb-4">
          Academic Responsibilities & Key Contributions
        </h2>
        <div class="text-xs sm:text-sm text-slate-700 leading-relaxed space-y-3">
          {asdos.slug.includes('dody') && (
            <>
              <p>
                <strong>Dody Erlangga, S.Kom.</strong> is an alumnus of Universitas Darwan Ali with specialized expertise in Multimedia Systems, Cross-platform Mobile Programming (Flutter/Dart), and Internet of Things (IoT).
              </p>
              <p>
                He serves as program portal manager, laboratory practicum instructor, and technical coordinator for student internship initiatives (MBKM).
              </p>
            </>
          )}

          {asdos.slug.includes('fauzan') && (
            <>
              <p>
                <strong>Fauzan Eka Prasatia, S.M.</strong> focuses on Digital Transformation, Information Systems Management, and Digital Leadership.
              </p>
              <p>
                Author of textbooks in digital leadership, he assists in organizational management coursework and institutional accreditation documentation.
              </p>
            </>
          )}

          {asdos.slug.includes('prio') && (
            <>
              <p>
                <strong>Prio Jaka Arsyad, S.Kom.</strong> specializes in Database Systems, Software Engineering, and Enterprise Application Integration.
              </p>
              <p>
                He provides technical laboratory support for programming classes and aids academic coordination for evening and executive classes.
              </p>
            </>
          )}
        </div>
      </div>

      {/* Technical Expertise */}
      <div class="card-academic p-6 sm:p-8">
        <h2 class="text-lg font-bold text-navy-900 font-editorial border-b border-slate-200 pb-3 mb-4">
          Technical Competencies
        </h2>
        <div class="flex flex-wrap gap-2">
          {asdos.expertise.map((exp: string) => (
            <span class="px-3 py-1.5 rounded bg-slate-100 text-navy-900 text-xs font-semibold border border-slate-200">
              {exp}
            </span>
          ))}
        </div>
      </div>

      {/* Back Button */}
      <div class="text-center pt-4">
        <a
          href="/en/faculty/#assistants"
          class="inline-flex items-center text-xs font-bold text-navy-900 hover:text-gold-700 underline"
        >
          ← Back to Teaching Assistants
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
