---
interface Props {
  currentLang?: 'id' | 'en';
}

const { currentLang = 'id' } = Astro.props;
import navigation from '../../data/navigation.json';
const isEn = currentLang === 'en';
---

<footer class="bg-navy-950 text-slate-300 border-t border-navy-800/80 pt-16 pb-12 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      {/* Col 1: Institutional Identity */}
      <div class="space-y-4">
        <div class="flex items-center space-x-3">
          <div class="flex items-center shrink-0 bg-white px-2 py-1 rounded-md shadow-sm border border-gold-500/30">
            <img src="/images/logo/logo-unda.png" alt="Logo Universitas Darwan Ali" width="40" height="40" class="h-10 w-auto object-contain" loading="lazy" />
            <span class="mx-2.5 h-8 w-px bg-slate-300" aria-hidden="true"></span>
            <img src="/images/logo/logo-sisfo.png" alt={isEn ? 'Logo of the Information Systems Program' : 'Logo S1 Sistem Informasi'} width="40" height="40" class="h-10 w-auto object-contain" loading="lazy" />
          </div>
          <div>
            <div class="font-bold text-white text-base">
              {isEn ? 'Information Systems' : 'S1 Sistem Informasi'}
            </div>
            <div class="text-xs text-slate-400">
              Fakultas Ilmu Komputer · Universitas Darwan Ali
            </div>
          </div>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          {isEn
            ? 'Delivering Outcome-Based Education (OBE) in AI, Data Science, and Enterprise Systems. Accredited "Baik Sekali" by BAN-PT.'
            : 'Menyelenggarakan pendidikan sarjana berbasis Outcome-Based Education (OBE) di bidang Kecerdasan Buatan, Sains Data, dan Sistem Enterprise. Terakreditasi "Baik Sekali".'}
        </p>
        <div class="pt-2">
          <span class="inline-block px-3 py-1 bg-navy-900 border border-gold-500/30 text-gold-400 rounded text-xs font-semibold">
            SK Akreditasi: Baik Sekali
          </span>
        </div>
      </div>

      {/* Col 2: Institutional Portals */}
      <div>
        <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-gold-500 pl-2">
          {isEn ? 'Institutional Portals' : 'Portal Layanan Institusi'}
        </h4>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href="https://univdarwanali.siakadcloud.com/spmbfront/program-studi-detail/detail/57201" target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors flex items-center">
              <span class="text-gold-500 mr-2">›</span> SPMB Online UNDA
            </a>
          </li>
          <li>
            <a href="https://siak.unda.ac.id/" target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors flex items-center">
              <span class="text-gold-500 mr-2">›</span> SIAKAD Cloud UNDA
            </a>
          </li>
          <li>
            <a href="https://edlink.id/" target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors flex items-center">
              <span class="text-gold-500 mr-2">›</span> Edlink Learning Platform
            </a>
          </li>
          <li>
            <a href="https://cloud.unda.ac.id/moodle" target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors flex items-center">
              <span class="text-gold-500 mr-2">›</span> Moodle eLearning UNDA
            </a>
          </li>
          <li>
            <a href="https://esign-fikom.unda.ac.id/" target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors flex items-center">
              <span class="text-gold-500 mr-2">›</span> eSign FIKOM UNDA
            </a>
          </li>
          <li>
            <a href="https://www.unda.ac.id" target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors flex items-center">
              <span class="text-gold-500 mr-2">›</span> Website Utama Universitas
            </a>
          </li>
        </ul>
      </div>

      {/* Col 3: Academic & Research Links */}
      <div>
        <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-gold-500 pl-2">
          {isEn ? 'Academic & Research' : 'Akademik & Riset'}
        </h4>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href={isEn ? '/en/academics/curriculum/' : '/akademik/kurikulum/'} class="hover:text-gold-400 transition-colors flex items-center">
              <span class="text-gold-500 mr-2">›</span> {isEn ? 'OBE Curriculum (144 Credits)' : 'Kurikulum OBE 144 SKS'}
            </a>
          </li>
          <li>
            <a href={isEn ? '/en/academics/rps/' : '/akademik/rps/'} class="hover:text-gold-400 transition-colors flex items-center">
              <span class="text-gold-500 mr-2">›</span> {isEn ? 'Syllabus (RPS) Repository' : 'Repositori Master RPS PDF'}
            </a>
          </li>
          <li>
            <a href={isEn ? '/en/faculty/' : '/civitas/'} class="hover:text-gold-400 transition-colors flex items-center">
              <span class="text-gold-500 mr-2">›</span> {isEn ? 'Faculty & Assistant Directory' : 'Direktori Dosen & Asisten'}
            </a>
          </li>
          <li>
            <a href={isEn ? '/en/research/groups/' : '/riset/kelompok-riset/'} class="hover:text-gold-400 transition-colors flex items-center">
              <span class="text-gold-500 mr-2">›</span> {isEn ? 'Research Groups' : 'Kelompok Riset Dosen'}
            </a>
          </li>
        </ul>
      </div>

      {/* Col 4: Contact & Secretariat */}
      <div class="space-y-3 text-xs">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-gold-500 pl-2">
          {isEn ? 'Secretariat & Contact' : 'Sekretariat & Kontak'}
        </h4>
        <p class="text-slate-400 leading-relaxed">
          <strong>Kampus Utama:</strong><br />
          Jl. Batu Berlian No. 10, Kel. Mentawa Baru Hulu, Kec. Mentawa Baru Ketapang, Kab. Kotawaringin Timur, Kalimantan Tengah 74322.
        </p>
        <ul class="space-y-2 text-slate-400">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href="mailto:sisteminformasi@unda.ac.id" class="text-gold-400 hover:underline break-all">sisteminformasi@unda.ac.id</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold-500 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 00-8.5 15l-1.5 5 5.2-1.4A9.9 9.9 0 1012.04 2zm5.8 14.1c-.25.7-1.4 1.3-1.9 1.35-.5.05-1.1.07-1.8-.12a14 14 0 01-5.3-3.2 9.7 9.7 0 01-2-3.1c-.3-1.1.1-2 .7-2.6.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.6-.3.4c-.1.2-.2.3 0 .6a8 8 0 002.4 2.2c.4.2.7.2.9 0l.6-.7c.2-.2.4-.2.6-.1l1.8.9c.2.1.4.2.4.3.1.2.1.8-.2 1.5z"/></svg>
            <a href="https://wa.me/6282358393889" target="_blank" rel="noopener noreferrer" class="text-gold-400 hover:underline">WhatsApp +62 823-5839-3889</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke-width="1.8"/><circle cx="12" cy="12" r="4" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            <a href="https://www.instagram.com/sisfounda/" target="_blank" rel="noopener noreferrer" class="text-gold-400 hover:underline">@sisfounda</a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="pt-8 border-t border-navy-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>
        &copy; {new Date().getFullYear()} Program Studi S1 Sistem Informasi, Fakultas Ilmu Komputer, Universitas Darwan Ali.
      </p>
      <div class="flex items-center space-x-4">
        <a href="#top" class="text-slate-400 hover:text-gold-400 transition-colors rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500">↑ {isEn ? 'Top' : 'Ke Atas'}</a>
      </div>
    </div>
  </div>
</footer>
